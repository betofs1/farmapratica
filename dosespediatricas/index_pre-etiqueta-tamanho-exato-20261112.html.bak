  <button class="theme-toggle" onclick="toggleTheme()" title="Alternar tema claro/escuro" aria-label="Alternar tema claro/escuro">
    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8L6 18M18 6l1.8-1.8"/></svg>
    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
  </button>
</div>

<div class="app-body mobile-vista-lista" id="app-body">
  <div class="sidebar">
    <div class="sidebar-header">
      <div class="search-box">
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></span>
        <input type="text" id="busca" placeholder="Busque por Fármaco">
        <button type="button" class="mobile-search-fechar" id="mobile-search-fechar" aria-label="Fechar busca" title="Fechar busca">
          <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
        </button>
      </div>
    </div>
    <div class="sidebar-list" id="lista-farmacos">
      <div class="skeleton-item" style="width:60%"></div>
      <div class="skeleton-item" style="width:85%"></div>
      <div class="skeleton-item" style="width:70%"></div>
      <div class="skeleton-item" style="width:80%"></div>
      <div class="skeleton-item" style="width:55%"></div>
    </div>
  </div>

  <div class="main">
    <div class="main-inner">
      <button type="button" class="btn-mobile-voltar no-print" id="btn-mobile-voltar" onclick="mobileMostrarLista()">
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></span>Lista de fármacos
      </button>
      <div id="conteudo">
        <div class="empty-state">
          <div class="empty-icon"><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 20.5L3.5 13.5a5 5 0 117.07-7.07l7 7a5 5 0 01-7.07 7.07z"/><path d="M8.5 8.5l7 7"/></svg></span></div>
          <div class="empty-title">Nenhum fármaco selecionado</div>
          <div class="empty-sub">Escolha um item na lista ao lado para calcular a dose por peso e idade.</div>
        </div>
      </div>
    </div>

    <div class="resultado-grid" id="resultado-grid"></div>

    <div class="aviso-responsabilidade">
        <div class="aviso-titulo"><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01M10.3 3.9L1.9 18a1.8 1.8 0 001.5 2.7h17.2a1.8 1.8 0 001.5-2.7L13.7 3.9a1.8 1.8 0 00-3.4 0z"/></svg></span> Aviso de Responsabilidade</div>

        <h4>Natureza da ferramenta</h4>
        <p>Esta calculadora é um <strong>instrumento de apoio à decisão clínica</strong>, destinado exclusivamente a profissionais de saúde habilitados (farmacêuticos, médicos, enfermeiros). Ela não substitui o julgamento clínico individualizado, a avaliação do paciente nem a consulta à bula oficial vigente do medicamento.</p>

        <h4>Fontes e atualização <span class="verificado-badge"><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>Base revisada em <span id="data-verificacao"></span></span></h4>
        <p>Os valores de dose, concentração e apresentação foram compilados com base em bulas registradas na ANVISA e diretrizes de sociedades médicas (SBP, entre outras) na data de elaboração desta ferramenta. Bulas podem ser atualizadas, descontinuadas ou substituídas por novas formulações a qualquer momento: <strong>sempre confirme a informação na bula vigente do produto efetivamente dispensado</strong> antes de orientar ou administrar qualquer medicamento.</p>

        <h4>Limitações do cálculo</h4>
        <ul>
          <li>Concentrações de suspensões, xaropes e gotas variam entre fabricantes e entre lotes de um mesmo fabricante. Confira sempre a concentração impressa na embalagem real.</li>
          <li>A conversão em gotas utiliza a calibração informada pelo fabricante quando conhecida; na ausência dela, aplica-se o padrão farmacotécnico de 20 gotas/mL, que é uma aproximação e pode não corresponder ao conta-gotas específico do produto dispensado.</li>
          <li>Doses máximas absolutas (tetos de segurança) devem ser respeitadas independentemente do resultado calculado por peso.</li>
          <li>Para fármacos com dose individualizada por gravidade clínica, faixa etária fixa ou apresentação em Unidades Internacionais (UI), o cálculo automático por peso não se aplica: a ferramenta sinaliza esses casos, mas a decisão permanece com o profissional.</li>
        </ul>

        <h4>Responsabilidade profissional</h4>
        <p>A prescrição, dispensação e administração de qualquer medicamento são de <strong>responsabilidade exclusiva do profissional de saúde habilitado</strong>, que deve considerar o quadro clínico completo do paciente, comorbidades, alergias, interações medicamentosas e demais fatores individuais, em conformidade com as normas do Conselho Federal de Farmácia (CFF), Conselho Federal de Medicina (CFM) e demais órgãos reguladores aplicáveis, incluindo a ANVISA.</p>

        <h4>Isenção de responsabilidade</h4>
        <p>O FarmaPrática e seus desenvolvedores não se responsabilizam por decisões clínicas, erros de dispensação, reações adversas ou quaisquer danos decorrentes do uso desta ferramenta, incluindo eventuais desatualizações, imprecisões ou erros de digitação nos dados apresentados. O uso desta calculadora implica a aceitação destas condições.</p>
    </div>
  </div>
</div>

<div class="mobile-search-backdrop" id="mobile-search-backdrop"></div>
<nav class="mobile-bottom-nav" id="mobile-bottom-nav">
  <button type="button" class="mobile-bottom-nav-item" id="btn-mobile-buscar">
    <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></span>
    <span>Buscar</span>
  </button>
  <button type="button" class="mobile-bottom-nav-item" id="btn-mobile-favoritos">
    <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l3.1 6.28 6.93 1-5.02 4.9 1.19 6.9-6.2-3.26-6.2 3.26 1.19-6.9-5.02-4.9 6.93-1z"/></svg></span>
    <span>Favoritos</span>
    <span class="fav-count" id="fav-count" style="display:none;"></span>
  </button>
</nav>

<script>
// ---------- Tema claro/escuro ----------
// 20/10/2026: a ferramenta agora inicia no modo escuro por padrão; a
// preferência salva é lida de volta logo no carregamento (script inline
// após o <body>) — a chave é compartilhada com as demais ferramentas do
// FarmaPrática, então a escolha feita em qualquer uma delas vale aqui também.
function toggleTheme(){
  document.body.classList.toggle('light');
  localStorage.setItem('farmapratica-theme', document.body.classList.contains('light') ? 'light' : 'dark');
}

// ---------- Ícones SVG reutilizados no JS ----------
const ICONS = {
  peso: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v2"/><path d="M5 6h14l1.5 9a2 2 0 01-2 2.3H5.5a2 2 0 01-2-2.3L5 6z"/><path d="M9 6a3 3 0 016 0"/></svg>',
  idade: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>',
  livro: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4.5A2.5 2.5 0 016.5 2H20v17H6.5A2.5 2.5 0 004 16.5v-12z"/><path d="M4 16.5A2.5 2.5 0 006.5 19H20"/></svg>',
  imprimir: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"/><rect x="6" y="13" width="12" height="8"/><path d="M4 9h16a1 1 0 011 1v6a1 1 0 01-1 1h-2M6 17H4a1 1 0 01-1-1v-6a1 1 0 011-1h2"/></svg>',
  copiar: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 01-1-1V4a1 1 0 011-1h10a1 1 0 011 1v1"/></svg>',
  link: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.07 0l2-2a5 5 0 00-7.07-7.07l-1 1"/><path d="M14 11a5 5 0 00-7.07 0l-2 2a5 5 0 007.07 7.07l1-1"/></svg>',
  chevron: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>',
  estrelaMini: '<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
  observacao: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>',
  // 08/11/2026: bolinha vermelha cheia, usada só no título "Observações" (h3),
  // para diferenciar do ícone de alerta (observacao) usado em cada item abaixo — pedido do usuário
  bolinhaObs: '<svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><circle cx="12" cy="12" r="8"/></svg>',
  check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>',
  gotas: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5s6.5 7.6 6.5 12.4a6.5 6.5 0 01-13 0C5.5 10.1 12 2.5 12 2.5z"/></svg>',
  liquido: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6v4.5l3.6 8.1A3 3 0 0115.8 19H8.2a3 3 0 01-2.8-4.4L9 6.5V2z"/><path d="M8 15h8"/></svg>',
  comprimido: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="9" width="19" height="6" rx="3" transform="rotate(-45 12 12)"/><path d="M9.5 9.5l5 5"/></svg>',
  injetavel: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.5 2.5l3 3M17 4l-11 11-3 6 6-3L20 7"/><path d="M12.5 8.5l3 3M9.5 11.5l3 3"/></svg>',
  supositorio: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c2.5 2 4 5.5 4 9.5A4 4 0 0112 16a4 4 0 01-4-4.5C8 7.5 9.5 4 12 2z"/><path d="M12 16v6"/></svg>',
  tag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.59 2H4a2 2 0 00-2 2v8.59a2 2 0 00.59 1.41l9 9a2 2 0 002.82 0l7.18-7.18a2 2 0 000-2.82l-9-9A2 2 0 0012.59 2z"/><circle cx="7.5" cy="7.5" r="1.3"/></svg>',
  fechar: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>',
  chevronLeft: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>',
  paciente: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 016-6h4a6 6 0 016 6v1"/></svg>',
  adulto: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="4"/><path d="M5 21v-2a7 7 0 0114 0v2"/></svg>',
  bebe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="6"/><path d="M9 11c.6 1 1.6 1.5 3 1.5s2.4-.5 3-1.5"/><circle cx="9.5" cy="9" r=".6" fill="currentColor" stroke="none"/><circle cx="14.5" cy="9" r=".6" fill="currentColor" stroke="none"/><path d="M12 16v2.3"/><circle cx="12" cy="19.6" r="1.7"/></svg>'
};

// Data de referência da última revisão geral da base (ajustar manualmente quando os dados forem revisados)
const DADOS_VERIFICADOS_EM = 'agosto/2026';
document.getElementById('data-verificacao').textContent = DADOS_VERIFICADOS_EM;

// ---------- Gate legal ----------
// O aceite é persistido (com versão e validade) para não interromper o uso repetido
// no mesmo plantão, mas volta a ser exibido se o texto legal for alterado (GATE_VERSAO)
// ou após o prazo de validade abaixo.
const GATE_VERSAO = 1;
const GATE_VALIDADE_HORAS = 24;
const GATE_KEY = 'farmapratica_gate_aceite';

function gateJaAceito(){
  try{
    const raw = localStorage.getItem(GATE_KEY);
    if(!raw) return false;
    const info = JSON.parse(raw);
    if(info.versao !== GATE_VERSAO) return false;
    const horasPassadas = (Date.now() - info.timestamp) / 3600000;
    return horasPassadas < GATE_VALIDADE_HORAS;
  }catch(e){ return false; }
}

(function(){
  const overlay = document.getElementById('gate-overlay');
  const checkbox = document.getElementById('gate-checkbox');
  const btn = document.getElementById('gate-btn');

  if(gateJaAceito()){
    overlay.style.display = 'none';
    document.body.classList.remove('gate-aberto');
  }

  checkbox.addEventListener('change', () => {
    if(checkbox.checked){
      btn.disabled = false;
      btn.classList.add('ativo');
    } else {
      btn.disabled = true;
      btn.classList.remove('ativo');
    }
  });

  btn.addEventListener('click', () => {
    if(!checkbox.checked) return;
    try{
      localStorage.setItem(GATE_KEY, JSON.stringify({ versao: GATE_VERSAO, timestamp: Date.now() }));
    }catch(e){}
    overlay.style.display = 'none';
    document.body.classList.remove('gate-aberto');
  });
})();

// ---------- Modal de nomes comerciais: fechar por botão, backdrop ou Esc ----------
document.getElementById('comerciais-fechar').addEventListener('click', fecharComerciais);
document.getElementById('comerciais-overlay').addEventListener('click', (e) => {
  if(e.target.id === 'comerciais-overlay') fecharComerciais();
});
document.addEventListener('keydown', (e) => {
  if(e.key !== 'Escape') return;
  if(document.getElementById('comerciais-overlay').classList.contains('aberto')){
    fecharComerciais();
  }
  if(document.getElementById('favoritos-overlay').classList.contains('aberto')){
    fecharFavoritosModal();
  }
  if(document.body.classList.contains('mobile-search-open')){
    fecharBuscaMobile();
  }
});

// ---------- Menu inferior mobile: busca ----------
// A busca sai da sidebar e vira um botão no menu inferior; ao tocar, o campo
// #busca (o mesmo da sidebar, reaproveitado) aparece como cartão flutuante por
// cima da lista, que continua visível e filtrando em tempo real atrás dele.
function abrirBuscaMobile(){
  mobileMostrarLista();
  document.body.classList.add('mobile-search-open');
  const busca = document.getElementById('busca');
  if(busca) setTimeout(() => busca.focus(), 50);
}
function fecharBuscaMobile(){
  document.body.classList.remove('mobile-search-open');
}
document.getElementById('btn-mobile-buscar').addEventListener('click', abrirBuscaMobile);
document.getElementById('mobile-search-fechar').addEventListener('click', fecharBuscaMobile);
document.getElementById('mobile-search-backdrop').addEventListener('click', fecharBuscaMobile);

// ---------- Menu inferior mobile: favoritos ----------
// Reaproveita o mesmo modal centralizado já usado para "Nomes comerciais"
// (#comerciais-overlay), com IDs próprios (#favoritos-overlay).
function renderFavoritosModal(){
  const body = document.getElementById('favoritos-body');
  if(!DB){
    body.innerHTML = '<div class="empty-sub" style="padding:16px 4px;">Carregando dados...</div>';
    return;
  }
  const favs = getFavsCalc();
  const favsValidos = favs.map(fv => DB.farmacos.find(f => f.id === fv.id)).filter(Boolean);
  body.innerHTML = '';
  if(!favsValidos.length){
    body.innerHTML = '<div class="empty-sub" style="padding:16px 4px;">Nenhum fármaco favoritado ainda. Toque na estrela dentro de um fármaco para adicioná-lo aqui.</div>';
    return;
  }
  favsValidos.forEach(f => {
    const btn = criarBotaoFarmaco(f, '');
    btn.addEventListener('click', fecharFavoritosModal);
    body.appendChild(btn);
  });
}
function abrirFavoritosModal(){
  renderFavoritosModal();
  document.getElementById('favoritos-overlay').classList.add('aberto');
}
function fecharFavoritosModal(){
  document.getElementById('favoritos-overlay').classList.remove('aberto');
}
document.getElementById('btn-mobile-favoritos').addEventListener('click', abrirFavoritosModal);
document.getElementById('favoritos-fechar').addEventListener('click', fecharFavoritosModal);
document.getElementById('favoritos-overlay').addEventListener('click', (e) => {
  if(e.target.id === 'favoritos-overlay') fecharFavoritosModal();
});
function atualizarFavCount(){
  const el = document.getElementById('fav-count');
  if(!el) return;
  const n = getFavsCalc().length;
  if(n > 0){ el.textContent = n; el.style.display = 'block'; }
  else{ el.style.display = 'none'; }
}
atualizarFavCount();

let DB = null;
let farmacoAtual = null;
let pesoAtual = 0;
let idadeAtual = 0;
let idadeUnidade = 'anos'; // 'anos' | 'meses'
const categoriasColapsadas = new Set();

fetch('dados.json')
  .then(r => r.json())
  .then(data => {
    DB = data;
    const ccEl = document.getElementById('calc-count-num');
    if(ccEl) ccEl.textContent = (DB.farmacos || []).length;
    renderSidebar();
    const deepId = new URLSearchParams(location.search).get('farmaco');
    if(deepId){ selecionarFarmaco(deepId); }
  })
  .catch(() => {
    document.getElementById('lista-farmacos').innerHTML = '<div class="empty-state"><div class="empty-title">Erro ao carregar dados.json</div><div class="empty-sub">Verifique a conexão e recarregue a página.</div></div>';
  });

// ---------- FAVORITOS (sincronizados com a pagina inicial) ----------
const CALC_FAV_KEY = 'dosespediatricas_favs_v1';
function getFavsCalc(){
  try{ return JSON.parse(localStorage.getItem(CALC_FAV_KEY) || '[]'); }
  catch(e){ return []; }
}
function saveFavsCalc(favs){
  try{ localStorage.setItem(CALC_FAV_KEY, JSON.stringify(favs)); }catch(e){}
}
function syncFavToHubCalc(id, label, added){
  try{
    const HUB_FAV_KEY = 'fp_favoritos_hub';
    const raw = localStorage.getItem(HUB_FAV_KEY);
    let list = raw ? JSON.parse(raw) : [];
    const hubId = 'calc-' + id;
    if(added){
      if(!list.some(f => f.id === hubId)){
        list.push({id: hubId, label: label, source: 'calc', sourceLabel: 'Calculadora de Doses', href: 'dosespediatricas/?farmaco=' + encodeURIComponent(id)});
      }
    } else {
      list = list.filter(f => f.id !== hubId);
    }
    localStorage.setItem(HUB_FAV_KEY, JSON.stringify(list));
  }catch(e){}
}
function toggleFavCalc(){
  if(!farmacoAtual) return;
  const id = farmacoAtual.id;
  let favs = getFavsCalc();
  const idx = favs.findIndex(f => f.id === id);
  if(idx === -1){
    favs.push({id, nome: farmacoAtual.nome});
    saveFavsCalc(favs);
    syncFavToHubCalc(id, farmacoAtual.nome, true);
  } else {
    favs.splice(idx, 1);
    saveFavsCalc(favs);
    syncFavToHubCalc(id, null, false);
  }
  renderConteudo();
  renderSidebar(document.getElementById('busca').value);
  atualizarFavCount();
}

function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function destacarTermo(nome, termo){
  if(!termo) return escapeHtml(nome);
  const idx = nome.toLowerCase().indexOf(termo);
  if(idx === -1) return escapeHtml(nome);
  return escapeHtml(nome.slice(0, idx)) + '<mark>' + escapeHtml(nome.slice(idx, idx + termo.length)) + '</mark>' + escapeHtml(nome.slice(idx + termo.length));
}

// Paleta de destaque por categoria (mesmos tons usados nos cartões de "Ferramentas" da INDEX),
// aplicada apenas como acento (borda/ponto) — o texto do cabeçalho continua neutro.
const CATEGORY_ACCENTS = [
  { cor: '#3b82f6', glow: 'rgba(59,130,246,.4)' },
  { cor: '#22c55e', glow: 'rgba(34,197,94,.4)' },
  { cor: '#a855f7', glow: 'rgba(168,85,247,.4)' },
  { cor: '#f59e0b', glow: 'rgba(245,158,11,.4)' },
  { cor: '#06b6d4', glow: 'rgba(6,182,212,.4)' },
  { cor: '#e4172c', glow: 'rgba(228,23,44,.4)' },
];
function accentDaCategoria(cat){
  const idx = DB.categorias.indexOf(cat);
  return CATEGORY_ACCENTS[(idx < 0 ? 0 : idx) % CATEGORY_ACCENTS.length];
}

function toggleCategoria(cat, groupEl){
  const colapsando = !groupEl.classList.contains('colapsado');
  if(colapsando) categoriasColapsadas.add(cat);
  else categoriasColapsadas.delete(cat);
  groupEl.classList.toggle('colapsado');
  const header = groupEl.querySelector('.cat-header');
  if(header) header.classList.toggle('colapsado');
}

function voltarParaCategoria(cat){
  categoriasColapsadas.delete(cat);
  document.getElementById('busca').value = '';
  farmacoAtual = null;
  history.replaceState(null, '', location.pathname);
  renderConteudo();
  renderSidebar('');
  mobileMostrarLista();
  const alvo = document.querySelector('.cat-header[data-categoria="' + CSS.escape(cat) + '"]');
  if(alvo){
    alvo.scrollIntoView({behavior:'smooth', block:'start'});
    alvo.classList.add('destacado');
    setTimeout(() => alvo.classList.remove('destacado'), 1200);
  }
}

// ---------- Navegação mobile em vista única (lista de fármacos OU fármaco selecionado) ----------
// Em telas <=800px a sidebar e o conteúdo não cabem empilhados de forma prática;
// #app-body alterna entre as classes abaixo (ver CSS) para mostrar uma vista por vez,
// com o botão "Lista de fármacos" (.btn-mobile-voltar) para retornar sem perder o
// fármaco/peso/idade já preenchidos. Em telas largas (desktop) essas classes não têm
// nenhum efeito — sidebar e conteúdo continuam lado a lado como sempre.
function mobileMostrarFarmaco(){
  const ab = document.getElementById('app-body');
  if(!ab) return;
  ab.classList.remove('mobile-vista-lista');
  ab.classList.add('mobile-vista-farmaco');
}
function mobileMostrarLista(){
  const ab = document.getElementById('app-body');
  if(!ab) return;
  ab.classList.remove('mobile-vista-farmaco');
  ab.classList.add('mobile-vista-lista');
  const listaEl = document.getElementById('lista-farmacos');
  if(listaEl) listaEl.scrollTop = 0;
}

function criarBotaoFarmaco(f, termo){
  const btn = document.createElement('button');
  btn.className = 'drug-item' + (farmacoAtual && farmacoAtual.id === f.id ? ' active' : '');
  const accent = accentDaCategoria(f.categoria);
  btn.style.setProperty('--cat-accent', accent.cor);
  btn.innerHTML = '<span class="drug-dot"></span><span class="drug-label">' + destacarTermo(f.nome, termo) + '</span>';
  btn.onclick = () => selecionarFarmaco(f.id);
  return btn;
}

function renderSidebar(filtro=''){
  const lista = document.getElementById('lista-farmacos');
  lista.innerHTML = '';
  const termo = filtro.trim().toLowerCase();

  // ----- seção de favoritos (fixa no topo, só aparece com filtro vazio) -----
  if(!termo){
    const favs = getFavsCalc();
    const favsValidos = favs
      .map(fv => DB.farmacos.find(f => f.id === fv.id))
      .filter(Boolean);
    if(favsValidos.length){
      const favGroup = document.createElement('div');
      favGroup.className = 'fav-group';
      const favHeader = document.createElement('div');
      favHeader.className = 'fav-header';
      favHeader.innerHTML = '<span class="icon">' + ICONS.estrelaMini + '</span> Favoritos';
      favGroup.appendChild(favHeader);
      favsValidos.forEach(f => favGroup.appendChild(criarBotaoFarmaco(f, termo)));
      lista.appendChild(favGroup);
    }
  }

  DB.categorias.forEach(cat => {
    const farmacosCat = DB.farmacos.filter(f => f.categoria === cat &&
      (!termo || f.nome.toLowerCase().includes(termo)));
    if(farmacosCat.length === 0) return;

    const accent = accentDaCategoria(cat);
    const colapsada = !termo && categoriasColapsadas.has(cat);
    const group = document.createElement('div');
    group.className = 'cat-group' + (colapsada ? ' colapsado' : '');

    const header = document.createElement('div');
    header.className = 'cat-header' + (colapsada ? ' colapsado' : '');
    header.dataset.categoria = cat;
    header.style.setProperty('--cat-accent', accent.cor);
    header.style.setProperty('--cat-accent-glow', accent.glow);
    header.innerHTML = '<span class="cat-label"><span class="cat-badge"><span class="cat-dot"></span></span><span>' + escapeHtml(cat) + '</span></span><span class="cat-count-mini">' + farmacosCat.length + '</span><span class="icon cat-chevron">' + ICONS.chevron + '</span>';
    header.onclick = (e) => toggleCategoria(cat, e.currentTarget.closest('.cat-group'));
    group.appendChild(header);

    const itemsWrap = document.createElement('div');
    itemsWrap.className = 'cat-items';
    farmacosCat.forEach(f => itemsWrap.appendChild(criarBotaoFarmaco(f, termo)));
    group.appendChild(itemsWrap);

    lista.appendChild(group);
  });
}

document.getElementById('busca').addEventListener('input', e => renderSidebar(e.target.value));

function selecionarFarmaco(id){
  farmacoAtual = DB.farmacos.find(f => f.id === id);
  renderSidebar(document.getElementById('busca').value);
  renderConteudo();
  mobileMostrarFarmaco();
}

function renderConteudo(){
  const el = document.getElementById('conteudo');
  if(!farmacoAtual){
    el.innerHTML = `
      <div class="empty-state">
        <div class="empty-icon"><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 20.5L3.5 13.5a5 5 0 117.07-7.07l7 7a5 5 0 01-7.07 7.07z"/><path d="M8.5 8.5l7 7"/></svg></span></div>
        <div class="empty-title">Nenhum fármaco selecionado</div>
        <div class="empty-sub">Escolha um item na lista ao lado para calcular a dose por peso e idade.</div>
      </div>
    `;
    document.getElementById('resultado-grid').innerHTML = '';
    document.body.classList.remove('modo-pediatrico');
    return;
  }
  const f = farmacoAtual;
  const bulaUrl = 'https://consultas.anvisa.gov.br/#/bulario/?nomeProduto=' + encodeURIComponent(f.nome.split('(')[0].trim());

  const _isFavCalc = getFavsCalc().some(fv => fv.id === f.id);
  el.innerHTML = `
    <div class="main-header">
      <div>
        <button type="button" class="breadcrumb-chip" onclick="voltarParaCategoria('${escapeHtml(f.categoria).replace(/'/g, "\\'")}')" title="Voltar para ${escapeHtml(f.categoria)}">
          <span class="icon">${ICONS.chevronLeft}</span>${f.categoria}
        </button>
        <h2>${f.nome}</h2>
        ${f.descricao ? `<p class="farmaco-descricao">${f.descricao}</p>` : ''}
      </div>
      <div class="main-header-actions no-print">
        <button class="btn-fav-calc${_isFavCalc ? ' starred' : ''}" onclick="toggleFavCalc()" title="Favoritar (aparece na página inicial)" aria-label="${_isFavCalc ? 'Remover dos favoritos' : 'Adicionar aos favoritos'}" aria-pressed="${_isFavCalc}">
          <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </button>
        <button class="btn-icon-action" id="btn-copiar-link" title="Copiar link direto deste fármaco" aria-label="Copiar link direto deste fármaco">
          <span class="icon">${ICONS.link}</span>
        </button>
        <button class="btn-icon-action" id="btn-imprimir" title="Imprimir / exportar em PDF" aria-label="Imprimir ou exportar em PDF">
          <span class="icon">${ICONS.imprimir}</span>
        </button>
        ${(f.nomesComerciais && f.nomesComerciais.length) ? `<button type="button" class="btn-nomes-comerciais" id="btn-comerciais" title="Ver nomes comerciais deste fármaco">
          <span class="icon">${ICONS.tag}</span>Nomes comerciais
        </button>` : ''}
        <a class="btn-bula" href="${bulaUrl}" target="_blank" rel="noopener">Ver bula ↗</a>
      </div>
    </div>

    <div class="secao-titulo"><span class="icon">${ICONS.paciente}</span>Dados do paciente</div>
    <div class="peso-bar">
      ${f.somenteIdade ? '' : `<div class="peso-field">
        <div class="field-icon"><span class="icon">${ICONS.peso}</span></div>
        <div class="field-inputs">
          <label>Peso</label>
          <div class="field-row">
            <input type="number" id="peso" min="0" step="0.1" placeholder="0" value="${pesoAtual || ''}" aria-label="Peso em quilogramas">
            <span>kg</span>
          </div>
        </div>
      </div>`}
      <div class="peso-field">
        <div class="field-icon"><span class="icon">${ICONS.idade}</span></div>
        <div class="field-inputs">
          <label>Idade</label>
          <div class="field-row">
            <input type="number" id="idade" min="0" step="${idadeUnidade === 'meses' ? '1' : '0.1'}" placeholder="0" value="${idadeAtual || ''}" aria-label="Idade">
            <div class="unidade-toggle">
              <button type="button" id="btn-meses" class="${idadeUnidade === 'meses' ? 'active' : ''}">Meses</button>
              <button type="button" id="btn-anos" class="${idadeUnidade === 'anos' ? 'active' : ''}">Anos</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="tipo-paciente-banner" id="tipo-paciente-banner" hidden aria-live="polite">
      <div class="tp-icon" id="tipo-paciente-icon"></div>
      <div class="tp-texto">
        <span class="tp-label" id="tipo-paciente-label"></span>
        <span class="tp-sub" id="tipo-paciente-sub"></span>
      </div>
    </div>

  `;

  document.getElementById('resultado-grid').innerHTML = `
    <div id="observacoes-container" aria-live="polite"></div>
    <div class="resultado-principal">
      <div id="teto-container" aria-live="polite"></div>
      <div class="formulacoes-grid" id="formulacoes" aria-live="polite"></div>
      <div class="fonte-tag"><span class="icon">${ICONS.livro}</span> Fonte: <b>${f.fonte}</b></div>
      <div class="print-only">
        Gerado pela Calculadora de Doses — FarmaPrática · Base revisada em ${DADOS_VERIFICADOS_EM}. Ferramenta de apoio à decisão clínica; não substitui a avaliação individualizada do paciente nem a bula vigente do medicamento efetivamente dispensado. A responsabilidade pela prescrição, dispensação e administração é do profissional de saúde habilitado.
      </div>
    </div>
  `;

  document.getElementById('btn-copiar-link').addEventListener('click', (e) => {
    const url = location.origin + location.pathname + '?farmaco=' + encodeURIComponent(f.id);
    copiarTexto(url, e.currentTarget);
  });
  document.getElementById('btn-imprimir').addEventListener('click', () => window.print());

  const btnComerciais = document.getElementById('btn-comerciais');
  if(btnComerciais){
    btnComerciais.addEventListener('click', () => abrirComerciais(f));
  }

  const campoPeso = document.getElementById('peso');
  if(campoPeso){
    campoPeso.addEventListener('input', e => {
      pesoAtual = parseFloat(e.target.value) || 0;
      calcularEExibir();
    });
  }
  document.getElementById('idade').addEventListener('input', e => {
    idadeAtual = parseFloat(e.target.value) || 0;
    calcularEExibir();
  });
  document.getElementById('btn-meses').addEventListener('click', () => trocarUnidadeIdade('meses'));
  document.getElementById('btn-anos').addEventListener('click', () => trocarUnidadeIdade('anos'));

  calcularEExibir();
}

function trocarUnidadeIdade(novaUnidade){
  if(novaUnidade === idadeUnidade) return;
  // converter o valor já digitado para manter a mesma idade real
  if(idadeAtual > 0){
    idadeAtual = (novaUnidade === 'meses') ? arred(idadeAtual * 12) : arred(idadeAtual / 12);
  }
  idadeUnidade = novaUnidade;
  renderConteudo();
}

// ---------- Modal de nomes comerciais ----------
function abrirComerciais(f){
  const overlay = document.getElementById('comerciais-overlay');
  document.getElementById('comerciais-titulo').textContent = 'Nomes comerciais — ' + f.nome;
  const nomes = f.nomesComerciais || [];
  const lista = nomes.map(n => `<li><span class="icon">${ICONS.tag}</span>${escapeHtml(n)}</li>`).join('');
  document.getElementById('comerciais-body').innerHTML = `
    <ul class="comerciais-lista">${lista}</ul>
    <p class="comerciais-aviso">Levantamento de marcas de referência e éticas disponíveis no mercado brasileiro para consulta rápida. A existência, o fabricante e a apresentação de cada marca podem mudar: confirme sempre no Bulário Eletrônico da ANVISA antes de orientar, prescrever ou dispensar.</p>
  `;
  overlay.classList.add('aberto');
}
function fecharComerciais(){
  document.getElementById('comerciais-overlay').classList.remove('aberto');
}

function seg(fixo, variavel){
  return `<span class="f-fixo">${fixo}</span> <span class="f-var">${variavel}</span>`;
}

// Ao imprimir, expande os detalhes de fórmula (normalmente recolhidos) para que
// o cálculo completo fique documentado na versão impressa/PDF.
let _detalhesAbertosAntesDeImprimir = [];
window.addEventListener('beforeprint', () => {
  _detalhesAbertosAntesDeImprimir = [];
  document.querySelectorAll('.formula-details').forEach(d => {
    if(!d.open){ d.open = true; _detalhesAbertosAntesDeImprimir.push(d); }
  });
});
window.addEventListener('afterprint', () => {
  _detalhesAbertosAntesDeImprimir.forEach(d => { d.open = false; });
  _detalhesAbertosAntesDeImprimir = [];
});

// ---------- Copiar texto para a área de transferência ----------
function copiarTexto(texto, btnEl){
  const marcarFeito = () => {
    if(!btnEl) return;
    const iconEl = btnEl.querySelector('.icon');
    const original = iconEl ? iconEl.innerHTML : null;
    btnEl.classList.add('feito');
    if(iconEl) iconEl.innerHTML = ICONS.check;
    setTimeout(() => {
      btnEl.classList.remove('feito');
      if(iconEl && original !== null) iconEl.innerHTML = original;
    }, 1600);
  };
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(texto).then(marcarFeito).catch(() => fallbackCopiar(texto, marcarFeito));
  } else {
    fallbackCopiar(texto, marcarFeito);
  }
}
function fallbackCopiar(texto, cb){
  try{
    const ta = document.createElement('textarea');
    ta.value = texto;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    if(cb) cb();
  }catch(e){}
}

function textoPlano(html){
  return html.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
}

// ---------- Selo de tipo de paciente (Adulto / Pediátrico) + tingimento da página ----------
function atualizarBannerPaciente(faixaClinica, idade, unidade){
  const banner = document.getElementById('tipo-paciente-banner');
  if(!banner) return;
  const iconEl = document.getElementById('tipo-paciente-icon');
  const labelEl = document.getElementById('tipo-paciente-label');
  const subEl = document.getElementById('tipo-paciente-sub');

  if(!faixaClinica){
    banner.hidden = true;
    document.body.classList.remove('modo-pediatrico');
    return;
  }

  banner.hidden = false;
  banner.classList.remove('tp-adulto', 'tp-pediatrico', 'tp-transicao');

  const unidadeTxt = unidade === 'meses' ? (idade === 1 ? 'mês' : 'meses') : (idade === 1 ? 'ano' : 'anos');
  const idadeTexto = `${idade} ${unidadeTxt}`;

  if(faixaClinica === 'adulto'){
    banner.classList.add('tp-adulto');
    iconEl.innerHTML = ICONS.adulto;
    labelEl.textContent = 'PACIENTE ADULTO';
    subEl.textContent = `Idade informada: ${idadeTexto} — posologia de adulto`;
    document.body.classList.remove('modo-pediatrico');
  } else if(faixaClinica === 'transicao'){
    banner.classList.add('tp-pediatrico', 'tp-transicao');
    iconEl.innerHTML = ICONS.bebe;
    labelEl.textContent = 'PACIENTE PEDIÁTRICO';
    subEl.textContent = `Idade informada: ${idadeTexto} — faixa de transição (dose por peso limitada ao teto de adulto)`;
    document.body.classList.add('modo-pediatrico');
  } else {
    banner.classList.add('tp-pediatrico');
    iconEl.innerHTML = ICONS.bebe;
    labelEl.textContent = 'PACIENTE PEDIÁTRICO';
    subEl.textContent = `Idade informada: ${idadeTexto}`;
    document.body.classList.add('modo-pediatrico');
  }
}

function calcularEExibir(){
  const f = farmacoAtual;
  const peso = pesoAtual;
  const idadeMeses = idadeUnidade === 'meses' ? idadeAtual : idadeAtual * 12;
  const idadeAnos = idadeMeses / 12;
  const formDiv = document.getElementById('formulacoes');
  const obsDiv = document.getElementById('observacoes-container');
  formDiv.innerHTML = '';
  obsDiv.innerHTML = '';

  // ----- classificação do paciente por idade (Adulto / Pediátrico / faixa de transição 12-18) -----
  // Corte padrão de 12 anos incompletos, ajustável por fármaco via idadeLimitePediatricaAnos
  // (ex.: mantido em 18 para fármacos de baixo índice terapêutico, quando aplicável).
  const idadeInformada = idadeAtual > 0;
  const limitePed = f.idadeLimitePediatricaAnos || 12;
  let faixaClinica = null; // 'pediatrico' | 'transicao' | 'adulto'
  if(idadeInformada){
    if(idadeAnos >= 18) faixaClinica = 'adulto';
    else if(idadeAnos >= limitePed) faixaClinica = 'transicao';
    else faixaClinica = 'pediatrico';
  }
  let usarRegimeAdulto = faixaClinica === 'adulto';
  let transicaoPorPeso = false;
  if(!usarRegimeAdulto && peso > 0 && f.pesoCorteAdultoKg && peso >= f.pesoCorteAdultoKg){
    usarRegimeAdulto = true;
    transicaoPorPeso = true;
  }
  // Alguns fármacos definem em bula um corte de idade próprio para o regime de
  // adulto (dose fixa), mais baixo que os 18 anos padrão — ex.: bulas que definem
  // "adultos e crianças acima de 12 anos" com posologia fixa, sem faixa de
  // transição por peso entre 12 e 18 anos. idadeRegimeAdultoMeses permite esse
  // corte por fármaco, independente de idadeLimitePediatricaAnos (que só afeta a
  // classificação exibida no banner, não o regime de cálculo).
  if(!usarRegimeAdulto && f.idadeRegimeAdultoMeses != null && idadeInformada && idadeMeses >= f.idadeRegimeAdultoMeses){
    usarRegimeAdulto = true;
  }
  atualizarBannerPaciente(faixaClinica, idadeAtual, idadeUnidade);

  // ----- calcular dose base (mg por administração) -----
  let dose = null; // {min, max} em mg por administração
  let infoMgKg = null; // para observação dinâmica
  let regimeUsado = null; // 'adulto' | 'pediatrico' | 'transicao'
  const db = f.doseBase;
  const da = f.doseAdulto;

  // ----- "Regra de ouro": trava de segurança final (dose calculada por peso nunca
  // ultrapassa a dose máxima diária de adulto), aplicável às formulações mg/kg -----
  // Declarada aqui (antes do cálculo da dose) porque aplicarTravaAdulto() é chamada
  // de dentro dos ramos mgkg_dia/mgkg_dose logo abaixo — declará-la só depois desses
  // ramos causava "Cannot access before initialization" (TDZ do `let`) sempre que a
  // trava realmente precisava ser acionada, travando o cálculo inteiro.
  let travaAdultoAplicada = false;
  function aplicarTravaAdulto(){
    if(!dose || !f.doseMaximaDiaAdultoMg || usarRegimeAdulto) return;
    const vezesDiaEfetivo = db.vezesDia || db.fracionamento || 1;
    const maxPorAdministracao = f.doseMaximaDiaAdultoMg / vezesDiaEfetivo;
    if(dose.max > maxPorAdministracao){
      dose.max = maxPorAdministracao;
      if(dose.min > maxPorAdministracao) dose.min = maxPorAdministracao;
      dose.capApplied = true;
      travaAdultoAplicada = true;
    }
  }

  // A dose fixa de adulto não depende do peso — fica fora do gate "peso > 0"
  // abaixo, que existe para as demais formas de cálculo (por kg).
  if(usarRegimeAdulto && da && da.modo === 'fixa'){
    regimeUsado = 'adulto';
    let doseMin = da.doseMg.min, doseMax = da.doseMg.max;
    dose = { min: doseMin, max: doseMax, capApplied:false };
    dose.formulaBase = [seg(
      'Dose fixa de adulto (posologia não calculada por peso)',
      `→ ${doseMin === doseMax ? formatarMg(doseMax) : formatarMg(doseMin)+'–'+formatarMg(doseMax)} por administração${da.doseMaximaDiaMg ? ' (máx. ' + formatarMg(da.doseMaximaDiaMg) + '/dia)' : ''}`
    )];
  } else if(peso > 0){
    if(usarRegimeAdulto && da && da.modo === 'mgkg'){
      regimeUsado = 'adulto';
      let doseMin = da.doseMgKg.min * peso;
      let doseMax = da.doseMgKg.max * peso;
      let capApplied = false;
      if(da.doseMaximaDoseMg){
        if(doseMin > da.doseMaximaDoseMg){ doseMin = da.doseMaximaDoseMg; capApplied = true; }
        if(doseMax > da.doseMaximaDoseMg){ doseMax = da.doseMaximaDoseMg; capApplied = true; }
      }
      dose = { min: doseMin, max: doseMax, capApplied };
      infoMgKg = { unidade: 'dose', min: da.doseMgKg.min, max: da.doseMgKg.max };
      dose.formulaBase = [seg(
        'Calcular a dose de adulto por peso: peso × mg/kg/dose',
        `→ ${peso} kg × ${da.doseMgKg.min}–${da.doseMgKg.max} mg/kg/dose = ${arred(doseMin)}–${arred(doseMax)} mg${capApplied ? ' (ajustado ao teto máximo por dose)' : ''}`
      )];
    } else if(db.tipo === 'mgkg_dia'){
      regimeUsado = (usarRegimeAdulto ? 'adulto' : faixaClinica) || 'pediatrico';
      let diaMin = db.doseMgKg.min * peso;
      let diaMax = db.doseMgKg.max * peso;
      let capApplied = false;
      if(db.doseMaximaDiaMg){
        if(diaMin > db.doseMaximaDiaMg){ diaMin = db.doseMaximaDiaMg; capApplied = true; }
        if(diaMax > db.doseMaximaDiaMg){ diaMax = db.doseMaximaDiaMg; capApplied = true; }
      }
      const frac = db.fracionamento || 1;
      dose = { min: diaMin/frac, max: diaMax/frac, capApplied };
      infoMgKg = { unidade: 'dia', min: db.doseMgKg.min, max: db.doseMgKg.max };
      dose.formulaBase = [
        seg(
          'Calcular a dose diária total: peso × mg/kg/dia',
          `→ ${peso} kg × ${db.doseMgKg.min}–${db.doseMgKg.max} mg/kg/dia = ${arred(db.doseMgKg.min*peso)}–${arred(db.doseMgKg.max*peso)} mg/dia${capApplied ? ' (ajustado ao teto máximo diário)' : ''}`
        ),
        seg(
          `Dividir pelo número de tomadas ao dia: total ÷ ${frac} tomada(s)`,
          `→ ${arred(db.doseMgKg.min*peso)}–${arred(db.doseMgKg.max*peso)} mg ÷ ${frac} = ${arred(dose.min)}–${arred(dose.max)} mg por administração`
        )
      ];
      aplicarTravaAdulto();
    } else if(db.tipo === 'mgkg_dose'){
      regimeUsado = (usarRegimeAdulto ? 'adulto' : faixaClinica) || 'pediatrico';
      let doseMin = db.doseMgKg.min * peso;
      let doseMax = db.doseMgKg.max * peso;
      let capApplied = false;
      if(db.doseMaximaDoseMg){
        if(doseMin > db.doseMaximaDoseMg){ doseMin = db.doseMaximaDoseMg; capApplied = true; }
        if(doseMax > db.doseMaximaDoseMg){ doseMax = db.doseMaximaDoseMg; capApplied = true; }
      }
      dose = { min: doseMin, max: doseMax, capApplied };
      infoMgKg = { unidade: 'dose', min: db.doseMgKg.min, max: db.doseMgKg.max };
      dose.formulaBase = [seg(
        'Calcular a dose por administração: peso × mg/kg/dose',
        `→ ${peso} kg × ${db.doseMgKg.min}–${db.doseMgKg.max} mg/kg/dose = ${arred(doseMin)}–${arred(doseMax)} mg${capApplied ? ' (ajustado ao teto máximo por dose)' : ''}`
      )];
      aplicarTravaAdulto();
    } else if(db.tipo === 'faixa_fixa'){
      regimeUsado = (usarRegimeAdulto ? 'adulto' : faixaClinica) || 'pediatrico';
      let faixa;
      if(db.faixasPorIdade){
        faixa = db.faixas.find(fx => idadeMeses <= fx.idadeMaxMeses) || db.faixas[db.faixas.length-1];
      } else {
        faixa = db.faixas.find(fx => peso <= fx.pesoMaxKg) || db.faixas[db.faixas.length-1];
      }
      if(faixa.mgPorKg){
        const frac = faixa.fracionamento || 1;
        const diaMg = faixa.mgPorKg * peso;
        dose = { min: diaMg/frac, max: diaMg/frac, capApplied:false };
        dose.formulaBase = [seg(
          `Enquadrar na faixa de dose (${faixa.descricao}) e calcular: peso × ${faixa.mgPorKg} mg/kg/dia`,
          `→ ${peso} kg × ${faixa.mgPorKg} mg/kg/dia = ${arred(diaMg)} mg/dia ÷ ${frac} tomada(s) = ${arred(dose.min)} mg por administração`
        )];
      } else if(faixa.doseMg !== null && faixa.doseMg !== undefined){
        if(typeof faixa.doseMg === 'object'){
          dose = { min: faixa.doseMg.min, max: faixa.doseMg.max, capApplied:false };
          dose.formulaBase = [seg(
            `Enquadrar na faixa fixa (${faixa.descricao}) por ${db.faixasPorIdade ? 'idade' : 'peso'}`,
            `→ dose fixa da faixa: ${faixa.doseMg.min}–${faixa.doseMg.max} mg (não calculada por mg/kg)`
          )];
        } else {
          dose = { min: faixa.doseMg, max: faixa.doseMg, capApplied:false };
          dose.formulaBase = [seg(
            `Enquadrar na faixa fixa (${faixa.descricao}) por ${db.faixasPorIdade ? 'idade' : 'peso'}`,
            `→ dose fixa da faixa: ${faixa.doseMg} mg (não calculada por mg/kg)`
          )];
        }
      }
      // Rótulo opcional da faixa (ex.: "Lactentes"), exibido como selo junto do
      // valor calculado nos cards de formulação que usam o doseBase padrão
      // (sem faixasTexto própria) — ver renderização mais abaixo.
      if(dose && faixa.rotulo) dose.rotuloFaixa = faixa.rotulo;
    }
  }

  // ----- idade mínima: aviso -----
  let avisoIdade = null;
  if(f.idadeMinimaMeses && idadeAtual > 0 && idadeMeses < f.idadeMinimaMeses){
    avisoIdade = `Idade informada abaixo da idade mínima orientada (${formatarIdadeMinima(f.idadeMinimaMeses)}). Reavaliar indicação.`;
  }
  // Quando o fármaco trava o cálculo abaixo da idade mínima (bloquearAbaixoIdadeMinima),
  // nenhuma dose é de fato calculada — usado abaixo para não exibir uma observação de
  // "dose calculada" (mg/kg) contraditória junto do alerta de bloqueio nos cards.
  const idadeBloqueada = !!(f.bloquearAbaixoIdadeMinima && f.idadeMinimaMeses && idadeAtual > 0 && idadeMeses < f.idadeMinimaMeses);

  // ----- render formulações -----
  // Em regime de adulto, oculta apresentações em "gotas" quando o fármaco também tem
  // outra apresentação (comprimido/líquido/etc.) disponível: gotas são, na prática
  // farmacêutica, uma forma concentrada pensada para doses pequenas de lactentes/crianças
  // — para um adulto, calcular a dose fixa de adulto em número de gotas resultaria em
  // quantidades grandes e clinicamente sem sentido (ex.: "80 gotas"). Quando gotas é a
  // ÚNICA apresentação cadastrada (ex.: colírios, óticos, algumas vitaminas), continua
  // sendo exibida normalmente — nesses casos a gota já é a via de administração real
  // para qualquer idade, não uma questão de conveniência posológica.
  // Exceção: quando o próprio fármaco tem posologia de adulto documentada em bula
  // especificamente para a apresentação em gotas (ex.: ibuprofeno gotas concentrado,
  // usado por adultos para dose fracionada), a formulação pode marcar
  // "exibirEmAdulto": true para não ser ocultada mesmo havendo alternativa não-gotas.
  const temAlternativaNaoGotas = f.formulacoes.some(x => x.tipo !== 'gotas');
  f.formulacoes.forEach(form => {
    if(usarRegimeAdulto && form.tipo === 'gotas' && temAlternativaNaoGotas && !form.exibirEmAdulto) return;
    const card = document.createElement('div');
    card.className = 'formulacao';

    let valorTexto = '-';
    let subItens = [];
    let formulaCompleta = null;
    let textoAlerta = null;

    if(f.bloquearAbaixoIdadeMinima && f.idadeMinimaMeses && idadeAtual > 0 && idadeMeses < f.idadeMinimaMeses){
      textoAlerta = f.textoAlertaIdadeMinima || `Não há posologia estabelecida em bula para menores de ${formatarIdadeMinima(f.idadeMinimaMeses)}. Reavaliar indicação clínica.`;
    } else if(form.faixasTextoPeso){
      if(peso <= 0){
        valorTexto = 'informe o peso';
      } else {
        const tier = form.faixasTextoPeso.find(t => peso <= t.pesoMaxKg) || form.faixasTextoPeso[form.faixasTextoPeso.length-1];
        valorTexto = tier.texto;
      }
    } else if(form.faixasTexto){
      if(idadeAtual <= 0){
        valorTexto = 'informe a idade';
      } else {
        const tier = form.faixasTexto.find(t => idadeMeses <= t.idadeMaxMeses) || form.faixasTexto[form.faixasTexto.length-1];
        if(tier.alerta){
          textoAlerta = tier.texto;
        } else if(tier.mgPorKg){
          // Sub-faixa calculada por peso dentro de uma formulação majoritariamente
          // baseada em texto fixo por idade (ex.: uma única faixa etária cuja bula
          // define a posologia em mg/kg, enquanto as demais faixas são dose fixa).
          if(peso <= 0){
            valorTexto = 'informe o peso';
          } else {
            const frac = tier.fracionamento || 1;
            const diaMg = tier.mgPorKg * peso;
            const doseAdmin = diaMg / frac;
            const sufixoFreq = tier.frequenciaTexto ? ` ${tier.frequenciaTexto}` : '';
            if(form.concentracaoMgMl){
              const ml = doseAdmin / form.concentracaoMgMl;
              valorTexto = `${arred(ml)} mL${sufixoFreq}`;
              formulaCompleta = [seg(
                `Enquadrar na faixa (${tier.descricao || 'calculada por peso'}) e calcular: peso × ${tier.mgPorKg} mg/kg/dia`,
                `→ ${peso} kg × ${tier.mgPorKg} mg/kg/dia = ${arred(diaMg)} mg/dia ÷ ${frac} tomada(s) = ${arred(doseAdmin)} mg por administração ÷ ${form.concentracaoMgMl} mg/mL = ${arred(ml)} mL`
              )];
            } else {
              valorTexto = `${arred(doseAdmin)} mg${sufixoFreq}`;
              formulaCompleta = [seg(
                `Enquadrar na faixa (${tier.descricao || 'calculada por peso'}) e calcular: peso × ${tier.mgPorKg} mg/kg/dia`,
                `→ ${peso} kg × ${tier.mgPorKg} mg/kg/dia = ${arred(diaMg)} mg/dia ÷ ${frac} tomada(s) = ${arred(doseAdmin)} mg por administração`
              )];
            }
          }
        } else if(tier.mgPorKgMin !== undefined && tier.mgPorKgMax !== undefined){
          // Variante em faixa (min–max) do mecanismo acima — para bulas que dão um
          // intervalo de mg/kg por administração (ex.: "0,3 a 0,6 mg/kg/dose"), em vez
          // de um único valor. fracionamento=1 (padrão) significa que mgPorKgMin/Max já
          // é a dose por administração; um fracionamento >1 indica que o intervalo é
          // diário e deve ser dividido pelo número de tomadas.
          if(peso <= 0){
            valorTexto = 'informe o peso';
          } else {
            const frac = tier.fracionamento || 1;
            const diaMgMin = tier.mgPorKgMin * peso;
            const diaMgMax = tier.mgPorKgMax * peso;
            const doseAdminMin = diaMgMin / frac;
            const doseAdminMax = diaMgMax / frac;
            const sufixoFreq = tier.frequenciaTexto ? ` ${tier.frequenciaTexto}` : '';
            const rotuloUnidade = frac > 1 ? 'mg/kg/dia' : 'mg/kg/dose';
            if(form.concentracaoMgMl){
              const mlMin = doseAdminMin / form.concentracaoMgMl;
              const mlMax = doseAdminMax / form.concentracaoMgMl;
              valorTexto = `${arred(mlMin)} – ${arred(mlMax)} mL${sufixoFreq}`;
              formulaCompleta = [seg(
                `Enquadrar na faixa (${tier.descricao || 'calculada por peso'}) e calcular: peso × ${tier.mgPorKgMin}–${tier.mgPorKgMax} ${rotuloUnidade}`,
                `→ ${peso} kg × ${tier.mgPorKgMin}–${tier.mgPorKgMax} ${rotuloUnidade} = ${arred(diaMgMin)}–${arred(diaMgMax)} mg${frac > 1 ? ` ÷ ${frac} tomada(s)` : ''} = ${arred(doseAdminMin)}–${arred(doseAdminMax)} mg por administração ÷ ${form.concentracaoMgMl} mg/mL = ${arred(mlMin)}–${arred(mlMax)} mL`
              )];
            } else {
              valorTexto = `${arred(doseAdminMin)} – ${arred(doseAdminMax)} mg${sufixoFreq}`;
              formulaCompleta = [seg(
                `Enquadrar na faixa (${tier.descricao || 'calculada por peso'}) e calcular: peso × ${tier.mgPorKgMin}–${tier.mgPorKgMax} ${rotuloUnidade}`,
                `→ ${peso} kg × ${tier.mgPorKgMin}–${tier.mgPorKgMax} ${rotuloUnidade} = ${arred(diaMgMin)}–${arred(diaMgMax)} mg${frac > 1 ? ` ÷ ${frac} tomada(s)` : ''} = ${arred(doseAdminMin)}–${arred(doseAdminMax)} mg por administração`
              )];
            }
          }
        } else {
          valorTexto = tier.texto;
        }
      }
    } else if(form.textoDoseFixo){
      valorTexto = form.textoDoseFixo;
    } else if(form.tipo === 'gotas' && form.calculoEspecial === 'gotas_por_kg'){
      // Regra prática (gotas/kg) tem prioridade sobre uma eventual dose fixa de
      // adulto: essas apresentações são de uso pediátrico e a regra depende do peso.
      if(peso <= 0){
        valorTexto = '00';
      } else {
        const gMin = Math.round(peso * 1);
        const gMax = Math.round(peso * 2);
        valorTexto = (gMin === gMax) ? `${gMax} gotas` : `${gMin} – ${gMax} gotas`;
        formulaCompleta = [seg('Calcular o número de gotas: peso × 1–2 gotas/kg', `→ ${peso} kg × 1–2 gotas/kg = ${gMin}–${gMax} gotas`)];
      }
    } else if(form.usarDoseBaseSempre && db && db.tipo === 'mgkg_dia' && peso > 0){
      // Exceção pontual: algumas apresentações líquidas/gotas têm, na própria bula,
      // uma posologia por peso válida "para adultos e crianças acima de X anos" —
      // ou seja, o regime de dose fixa de adulto (doseAdulto) NÃO se aplica a essa
      // apresentação específica, mesmo quando o paciente já está classificado como
      // adulto. As demais apresentações do fármaco (comprimido, supositório etc.)
      // continuam usando o fluxo normal (dose fixa de adulto a partir de 18 anos).
      let diaMin = db.doseMgKg.min * peso;
      let diaMax = db.doseMgKg.max * peso;
      let capApplied2 = false;
      if(db.doseMaximaDiaMg){
        if(diaMin > db.doseMaximaDiaMg){ diaMin = db.doseMaximaDiaMg; capApplied2 = true; }
        if(diaMax > db.doseMaximaDiaMg){ diaMax = db.doseMaximaDiaMg; capApplied2 = true; }
      }
      const frac2 = db.fracionamento || 1;
      const doseMin = diaMin / frac2;
      const doseMax = diaMax / frac2;
      const formulaBase2 = [seg(
        `Calcular a dose diária total: peso × mg/kg/dia (posologia por peso válida para qualquer idade ≥ ${formatarIdadeMinima(f.idadeMinimaMeses || 0)}, inclusive adultos, conforme bula desta apresentação)`,
        `→ ${peso} kg × ${db.doseMgKg.min}–${db.doseMgKg.max} mg/kg/dia = ${arred(db.doseMgKg.min*peso)}–${arred(db.doseMgKg.max*peso)} mg/dia${capApplied2 ? ' (ajustado ao teto máximo diário)' : ''} ÷ ${frac2} tomada(s) = ${arred(doseMin)}–${arred(doseMax)} mg por administração`
      )];

      if(form.tipo === 'gotas' && form.mgPorGota){
        const gMin = Math.round(doseMin / form.mgPorGota);
        const gMax = Math.round(doseMax / form.mgPorGota);
        valorTexto = (gMin === gMax) ? `${gMax} gotas` : `${gMin} – ${gMax} gotas`;
        formulaCompleta = [...formulaBase2, seg('Converter a dose em gotas: dose ÷ mg por gota', `→ ${arred(doseMin)}–${arred(doseMax)} mg ÷ ${form.mgPorGota} mg/gota = ${gMin}–${gMax} gotas`)];
      } else if((form.tipo === 'liquido' || form.tipo === 'injetavel') && form.concentracaoMgMl){
        const mlMin = doseMin / form.concentracaoMgMl;
        const mlMax = doseMax / form.concentracaoMgMl;
        valorTexto = (Math.abs(mlMax-mlMin) < 0.05) ? `${arred(mlMax)} mL` : `${arred(mlMin)} – ${arred(mlMax)} mL`;
        formulaCompleta = [...formulaBase2, seg('Converter a dose em volume: dose ÷ concentração', `→ ${arred(doseMin)}–${arred(doseMax)} mg ÷ ${form.concentracaoMgMl} mg/mL = ${arred(mlMin)}–${arred(mlMax)} mL`)];
      } else {
        valorTexto = `${arred(doseMin)} – ${arred(doseMax)} mg`;
        formulaCompleta = formulaBase2;
      }
    } else if(dose){
      // 'dose' já pode estar calculada sem depender do peso (ex.: dose fixa de
      // adulto) — verificar antes do gate "peso <= 0" abaixo, para não bloquear
      // indevidamente um valor que já está pronto.
      const doseMin = form.doseMaximaPorDoseMg ? Math.min(dose.min, form.doseMaximaPorDoseMg) : dose.min;
      const doseMax = form.doseMaximaPorDoseMg ? Math.min(dose.max, form.doseMaximaPorDoseMg) : dose.max;

      if(form.tipo === 'gotas' && form.mgPorGota){
        const gMin = Math.round(doseMin / form.mgPorGota);
        const gMax = Math.round(doseMax / form.mgPorGota);
        valorTexto = (gMin === gMax) ? `${gMax} gotas` : `${gMin} – ${gMax} gotas`;
        formulaCompleta = [...(dose.formulaBase || []), seg('Converter a dose em gotas: dose ÷ mg por gota', `→ ${arred(doseMin)}–${arred(doseMax)} mg ÷ ${form.mgPorGota} mg/gota = ${gMin}–${gMax} gotas`)];
      } else if((form.tipo === 'liquido' || form.tipo === 'injetavel') && form.concentracaoMgMl){
        const mlMin = doseMin / form.concentracaoMgMl;
        const mlMax = doseMax / form.concentracaoMgMl;
        valorTexto = (Math.abs(mlMax-mlMin) < 0.05) ? `${arred(mlMax)} mL` : `${arred(mlMin)} – ${arred(mlMax)} mL`;
        formulaCompleta = [...(dose.formulaBase || []), seg('Converter a dose em volume: dose ÷ concentração', `→ ${arred(doseMin)}–${arred(doseMax)} mg ÷ ${form.concentracaoMgMl} mg/mL = ${arred(mlMin)}–${arred(mlMax)} mL`)];
      } else if(form.tipo === 'comprimido' && form.mgPorComprimido){
        let cMin = arredondarMeio(doseMin / form.mgPorComprimido);
        let cMax = arredondarMeio(doseMax / form.mgPorComprimido);
        if(cMax < 0.5){
          valorTexto = 'fracionamento não recomendado';
          subItens.push({tipo:'restricao', texto:'Dose calculada resulta em fração muito pequena do comprimido. Preferir apresentação líquida ou gotas.'});
        } else {
          valorTexto = (cMin === cMax) ? `${formatarComprimidos(cMax)}` : `${formatarComprimidos(cMin)} – ${formatarComprimidos(cMax)}`;
        }
        formulaCompleta = [...(dose.formulaBase || []), seg('Converter a dose em comprimidos: dose ÷ mg por comprimido', `→ ${arred(doseMin)}–${arred(doseMax)} mg ÷ ${form.mgPorComprimido} mg = ${cMin}–${cMax} comp.`)];
      } else if(form.tipo === 'supositorio' && form.mgPorSupositorio){
        let sMin = Math.round(doseMin / form.mgPorSupositorio);
        let sMax = Math.round(doseMax / form.mgPorSupositorio);
        if(sMax < 1){
          valorTexto = 'dose inferior à menor apresentação';
          subItens.push({tipo:'restricao', texto:'Dose calculada é menor que 1 supositório desta apresentação. Reavaliar via ou apresentação adequada ao peso.'});
        } else {
          if(sMin < 1) sMin = 1;
          valorTexto = (sMin === sMax) ? `${sMax} supositório${sMax > 1 ? 's' : ''}` : `${sMin} – ${sMax} supositório(s)`;
        }
        formulaCompleta = [...(dose.formulaBase || []), seg('Converter a dose em supositórios: dose ÷ mg por unidade', `→ ${arred(doseMin)}–${arred(doseMax)} mg ÷ ${form.mgPorSupositorio} mg = ${sMin}–${sMax} unidade(s)`)];
      } else {
        valorTexto = `${arred(doseMin)} – ${arred(doseMax)} mg`;
        formulaCompleta = dose.formulaBase || null;
      }
    } else if(peso <= 0){
      valorTexto = '00';
    }

    // dose máxima por dose (texto)
    if(form.doseMaximaPorDoseMg){
      subItens.push({tipo:'info', texto:`dose máxima de ${form.doseMaximaPorDoseMg} mg por dose (via ${form.tipo === 'injetavel' ? 'injetável' : 'oral'})`});
    } else if(db.doseMaximaDoseMg && form.tipo !== 'comprimido'){
      subItens.push({tipo:'info', texto:`dose máxima de ${db.doseMaximaDoseMg} mg por dose`});
    }

    if(form.apresentacaoTexto){
      subItens.push({tipo:'info', texto:`apresentação: ${form.apresentacaoTexto}`});
    }
    if(form.diluicaoTexto){
      subItens.push({tipo:'info', texto: form.diluicaoTexto});
    }
    (form.restricoes||[]).forEach(r => subItens.push({tipo:'restricao', texto:r}));

    const icone = ICONS[form.tipo] || ICONS.comprimido;
    const temValorCalculado = !textoAlerta && valorTexto && !['informe o peso', 'informe a idade', '00'].includes(valorTexto);
    const prefixoInstrucao = temValorCalculado ? '<span class="instrucao-verbo">Administrar</span> ' : '';
    // Selo opcional de sub-faixa etária nomeada (ex.: "Lactentes"), só quando a
    // formulação usa o doseBase padrão (não tem faixasTexto própria) e a faixa
    // escolhida pelo motor para esta idade tem um `rotulo` definido no JSON.
    const rotuloFaixaBadge = (temValorCalculado && !form.faixasTexto && dose && dose.rotuloFaixa) ? dose.rotuloFaixa : null;

    card.innerHTML = `
      <div class="form-head">
        <div class="form-icon tipo-${form.tipo}"><span class="icon">${icone}</span></div>
        <h3>${form.rotulo}</h3>
        ${temValorCalculado ? `<div class="form-acoes no-print"><button class="btn-copiar-dose" type="button"><span class="icon">${ICONS.copiar}</span>Copiar</button><button class="btn-copiar-dose btn-etiqueta" type="button" title="Gerar etiqueta de posologia para o frasco/caixa"><span class="icon">${ICONS.imprimir}</span>Etiqueta</button></div>` : ''}
      </div>
      ${textoAlerta
        ? `<div class="linha-principal alerta-idade"><span class="icon">${ICONS.observacao}</span><span>${textoAlerta}</span></div>`
        : `<div class="linha-principal">${rotuloFaixaBadge ? `<span class="faixa-rotulo-badge">${rotuloFaixaBadge}</span>` : ''}${prefixoInstrucao}<span class="valor-pill">${_decBR(valorTexto)}</span>${form.viaTexto || ''}</div>`
      }
      ${temValorCalculado ? visualDoseHTML(form, valorTexto) : ''}
      ${temValorCalculado && formulaCompleta && formulaCompleta.length ? equacaoHTML(formulaCompleta) : ''}
      ${subItens.length ? `<ul class="sub-lista">
        ${subItens.map(i => `<li class="${i.tipo}">${i.texto}</li>`).join('')}
      </ul>` : ''}
      ${formulaCompleta && formulaCompleta.length ? `<details class="formula-details">
        <summary class="no-print"><span class="icon">${ICONS.chevron}</span>Ver a explicação de cada passo</summary>
        <div class="formula-content">
          <ol class="formula-steps">
            ${formulaCompleta.map(passo => `<li>${passo}</li>`).join('')}
          </ol>
        </div>
      </details>` : ''}
    `;
    if(temValorCalculado){
      const textoCopia = `${f.nome} — ${form.rotulo}: ${_decBR(textoPlano(valorTexto))}${form.viaTexto ? ' ' + textoPlano(form.viaTexto) : ''} (peso ${peso} kg${idadeAtual > 0 ? ', idade ' + idadeAtual + ' ' + idadeUnidade : ''})`;
      card.querySelector('.btn-copiar-dose').addEventListener('click', (e) => copiarTexto(textoCopia, e.currentTarget));
      card.querySelector('.btn-etiqueta').addEventListener('click', () => abrirEtiqueta({ f, form, valorTexto }));
    }
    formDiv.appendChild(card);
  });

  // ----- teto diário (indicador visual) -----
  const tetoEl = document.getElementById('teto-container');
  if(tetoEl) tetoEl.innerHTML = tetoDiarioHTML({ f, dose, db, da, regimeUsado, idadeBloqueada });

  // ----- observações -----
  const obsItens = [];

  if(dose && infoMgKg && peso > 0 && !idadeBloqueada){
    const mediaDose = (dose.min + dose.max) / 2;
    const mgkgCalc = arred(mediaDose / peso);
    const unidadeTxt = infoMgKg.unidade === 'dia' ? 'mg/kg/dia' : 'mg/kg/dose';
    const recTxt = infoMgKg.min === infoMgKg.max ? `${infoMgKg.min} ${unidadeTxt}` : `${infoMgKg.min}-${infoMgKg.max} ${unidadeTxt}`;
    obsItens.push(`Dose calculada equivalente a aproximadamente ${mgkgCalc} ${unidadeTxt} (recomendação de referência: ${recTxt}).`);
  }
  if(travaAdultoAplicada){
    obsItens.push(`Trava de segurança: a dose calculada pelo peso ultrapassaria a dose máxima de adulto (${formatarMg(f.doseMaximaDiaAdultoMg)}/dia) e foi ajustada a esse teto.`);
  } else if(dose && dose.capApplied){
    obsItens.push('A dose calculada pelo peso ultrapassaria o teto recomendado: valor ajustado para a dose máxima de segurança.');
  }
  if(faixaClinica === 'transicao' && !usarRegimeAdulto && f.doseMaximaDiaAdultoMg){
    obsItens.push(`Paciente adolescente (${limitePed}–17 anos): dose ajustada ao peso, limitada à dose convencional de adulto (máx. ${formatarMg(f.doseMaximaDiaAdultoMg)}/dia). Avaliar peso, estadiamento puberal e farmacocinética do fármaco.`);
  }
  if(transicaoPorPeso && f.pesoCorteAdultoKg){
    obsItens.push(`Peso ≥ ${f.pesoCorteAdultoKg} kg: conduta ajustada para a posologia convencional de adulto, independentemente da idade.`);
  }
  if(faixaClinica === 'adulto' && !da && dose){
    obsItens.push('Dose específica de adulto ainda não cadastrada para este fármaco: valor extrapolado pelo cálculo por peso, com a trava de segurança de adulto ativa.');
  }
  if(avisoIdade){ obsItens.push(avisoIdade); }
  if(f.idadeMinimaMeses > 0){
    obsItens.push(`Não recomendado / contraindicado o uso para menores de ${formatarIdadeMinima(f.idadeMinimaMeses)}.`);
  }
  if(db.doseMaximaDiaMg && !usarRegimeAdulto){
    obsItens.push(`Dose máxima diária de ${formatarMg(db.doseMaximaDiaMg)}.`);
  } else if(usarRegimeAdulto && da && da.doseMaximaDiaMg){
    obsItens.push(`Dose máxima diária de adulto: ${formatarMg(da.doseMaximaDiaMg)}.`);
  }
  (f.observacoesExtras || []).forEach(o => obsItens.push(o));

  if(obsItens.length){
    obsDiv.innerHTML = `
      <div class="observacoes">
        <h3><span class="icon">${ICONS.bolinhaObs}</span> Observações</h3>
        ${obsItens.map(o => `<div class="obs-item"><span class="icon">${ICONS.observacao}</span><span>${o}</span></div>`).join('')}
      </div>
    `;
  }
}

// =====================================================================
// 10/11/2026 — Memória de cálculo visível, visual da dose (seringa / copo
// dosador / comprimidos), indicador de teto diário e etiqueta de posologia.
// =====================================================================

// ---------- Memória de cálculo (equação sempre visível) ----------
function _decBR(s){ return String(s).replace(/(\d)\.(\d{1,2})(?!\d)/g, '$1,$2'); }
function _termoEq(t, ultimo){
  t = t.trim();
  let nota = '';
  const mNota = t.match(/\s*(\([^)]*\))\s*$/);
  if(mNota){ nota = mNota[1]; t = t.slice(0, mNota.index).trim(); }
  return `<span class="eq-termo${ultimo ? ' eq-resultado' : ''}">${_decBR(t)}</span>` +
         (nota ? `<span class="eq-nota">${_decBR(nota)}</span>` : '');
}
function equacaoHTML(passos){
  const linhas = [];
  passos.forEach(p => {
    const m = String(p).match(/<span class="f-var">([\s\S]*?)<\/span>\s*$/);
    let v = (m ? m[1] : textoPlano(p)).replace(/^\s*→\s*/, '').trim();
    if(!/[×÷=]/.test(v)) return;              // passo descritivo (dose fixa etc.)
    linhas.push(v);
  });
  if(!linhas.length) return '';
  const html = linhas.map((v, li) => {
    const partes = v.split(/\s([×÷=])\s/);
    let out = '';
    partes.forEach((pt, i) => {
      if(i % 2 === 1){ out += `<span class="eq-op">${pt}</span>`; }
      else { out += _termoEq(pt, li === linhas.length - 1 && i === partes.length - 1); }
    });
    return `<div class="eq-linha">${out}</div>`;
  }).join('');
  return `<div class="memoria-calculo">
    <div class="memoria-titulo"><span class="icon">${ICONS.check}</span>Memória de cálculo</div>
    ${html}
  </div>`;
}

// ---------- Visual da dose ----------
function _numBR(n){ return _decBR(arred(n)); }
function _parseML(txt){
  const m = String(txt).match(/^\s*([\d.]+)(?:\s*–\s*([\d.]+))?\s*mL/);
  if(!m) return null;
  const a = parseFloat(m[1]), b = m[2] ? parseFloat(m[2]) : a;
  if(!(a > 0) || !(b > 0)) return null;
  return { min: Math.min(a,b), max: Math.max(a,b) };
}
function _parseComp(txt){
  const re = /(\d+)?(½)?\s*(?:comprimido|cápsula|capsula|drágea|dragea)/gi;
  const vals = []; let m;
  while((m = re.exec(txt))){
    const v = (m[1] ? parseInt(m[1], 10) : 0) + (m[2] ? 0.5 : 0);
    if(v > 0) vals.push(v);
  }
  if(!vals.length) return null;
  return { min: Math.min(...vals), max: Math.max(...vals) };
}
function seringaSVG(ml, injetavel){
  const caps = [1, 3, 5, 10, 20];
  const cap = caps.find(c => ml.max <= c);
  if(!cap) return copoSVG(ml);
  const x0 = 46, x1 = 266, w = x1 - x0, y = 22, h = 30;
  const px = v => x0 + (Math.min(v, cap) / cap) * w;
  const passo = cap <= 1 ? 0.1 : cap <= 3 ? 0.1 : cap <= 5 ? 0.2 : cap <= 10 ? 0.5 : 1;
  const maior = cap <= 1 ? 0.5 : cap <= 5 ? 1 : cap <= 10 ? 2 : 5;
  let ticks = '';
  for(let v = 0; v <= cap + 1e-9; v += passo){
    const vv = Math.round(v * 100) / 100;
    const ehMaior = Math.abs(vv / maior - Math.round(vv / maior)) < 1e-6;
    const xx = px(vv);
    ticks += `<line x1="${xx}" y1="${y}" x2="${xx}" y2="${y + (ehMaior ? 12 : 6)}" class="sr-tick"/>`;
    if(ehMaior) ticks += `<text x="${xx}" y="${y + h + 14}" class="sr-num">${_decBR(vv)}</text>`;
  }
  const fMin = px(ml.min), fMax = px(ml.max);
  const faixa = ml.max > ml.min ? `<rect x="${fMin}" y="${y + 1}" width="${fMax - fMin}" height="${h - 2}" class="sr-faixa"/>` : '';
  return `<svg class="seringa-svg" viewBox="0 0 300 76" role="img" aria-label="Seringa de ${cap} mL marcada em ${_numBR(ml.max)} mL">
    <rect x="${x0 - 30}" y="${y + 8}" width="8" height="${h - 16}" rx="2" class="sr-corpo"/>
    <rect x="${x0 - 22}" y="${y + 12}" width="22" height="${h - 24}" class="sr-corpo"/>
    <rect x="${x0}" y="${y + 1}" width="${fMin - x0}" height="${h - 2}" class="sr-liquido"/>
    ${faixa}
    <rect x="${x0}" y="${y}" width="${w}" height="${h}" rx="3" class="sr-tubo"/>
    ${ticks}
    <rect x="${fMax}" y="${y + 1}" width="5" height="${h - 2}" class="sr-embolo-borracha"/>
    <line x1="${fMax + 5}" y1="${y + h / 2}" x2="${x1 + 26}" y2="${y + h / 2}" class="sr-haste"/>
    <rect x="${x1 + 26}" y="${y - 4}" width="5" height="${h + 8}" rx="2" class="sr-corpo"/>
    <line x1="${x1}" y1="${y - 6}" x2="${x1}" y2="${y + h + 6}" class="sr-aba"/>
  </svg>
  <div class="visual-legenda">${injetavel ? 'Seringa' : 'Seringa dosadora oral'} de ${cap} mL · aspirar até <b>${ml.max > ml.min ? _numBR(ml.min) + '–' + _numBR(ml.max) : _numBR(ml.max)} mL</b></div>`;
}
function copoSVG(ml){
  const cap = ml.max <= 30 ? 30 : Math.ceil(ml.max / 10) * 10;
  const yTopo = 14, yBase = 104, xa = 40, xb = 120;
  const py = v => yBase - (Math.min(v, cap) / cap) * (yBase - yTopo);
  let ticks = '';
  for(let v = 5; v <= cap; v += 5){
    const yy = py(v);
    ticks += `<line x1="${xb - 18}" y1="${yy}" x2="${xb - 4}" y2="${yy}" class="sr-tick"/><text x="${xb + 8}" y="${yy + 3}" class="sr-num" text-anchor="start">${v}</text>`;
  }
  const yMax = py(ml.max), yMin = py(ml.min);
  return `<svg class="copo-svg" viewBox="0 0 170 116" role="img" aria-label="Copo dosador marcado em ${_numBR(ml.max)} mL">
    <rect x="${xa + 2}" y="${yMin}" width="${xb - xa - 4}" height="${yBase - yMin}" class="sr-liquido"/>
    ${ml.max > ml.min ? `<rect x="${xa + 2}" y="${yMax}" width="${xb - xa - 4}" height="${yMin - yMax}" class="sr-faixa"/>` : ''}
    <path d="M${xa} ${yTopo} L${xa} ${yBase} Q${xa} ${yBase + 6} ${xa + 6} ${yBase + 6} L${xb - 6} ${yBase + 6} Q${xb} ${yBase + 6} ${xb} ${yBase} L${xb} ${yTopo}" class="sr-tubo"/>
    ${ticks}
    <line x1="${xa - 8}" y1="${yMax}" x2="${xb + 4}" y2="${yMax}" class="sr-marca"/>
  </svg>
  <div class="visual-legenda">Copo dosador · encher até <b>${ml.max > ml.min ? _numBR(ml.min) + '–' + _numBR(ml.max) : _numBR(ml.max)} mL</b></div>`;
}
function comprimidosSVG(c, capsula){
  const n = Math.ceil(c.max);
  if(n < 1 || n > 6) return '';
  let itens = '';
  for(let i = 0; i < n; i++){
    const resto = c.max - i;
    const meio = resto > 0 && resto < 1;
    const cx = 26 + i * 50;
    const opcional = (i + (meio ? 0.5 : 1)) > c.min + 1e-9;   // parte acima do mínimo da faixa
    if(capsula){
      itens += `<g class="cp-item${opcional ? ' cp-opcional' : ''}"><rect x="${cx - 20}" y="12" width="40" height="22" rx="11" class="cp-fundo"/>
        <path d="M${cx} 12 h9 a11 11 0 0 1 0 22 h-9 z" class="cp-cheio"/>${meio ? `<line x1="${cx}" y1="8" x2="${cx}" y2="38" class="cp-corte"/>` : `<path d="M${cx} 12 h-9 a11 11 0 0 0 0 22 h9 z" class="cp-cheio cp-cheio2"/>`}</g>`;
    } else {
      itens += `<g class="cp-item${opcional ? ' cp-opcional' : ''}"><circle cx="${cx}" cy="23" r="18" class="cp-fundo"/>
        ${meio ? `<path d="M${cx} 5 A18 18 0 0 0 ${cx} 41 Z" class="cp-cheio"/><line x1="${cx}" y1="3" x2="${cx}" y2="43" class="cp-corte"/>` : `<circle cx="${cx}" cy="23" r="18" class="cp-cheio"/><line x1="${cx - 11}" y1="23" x2="${cx + 11}" y2="23" class="cp-sulco"/>`}</g>`;
    }
  }
  const txt = c.max > c.min ? `${_numBR(c.min)} a ${_numBR(c.max)}` : _numBR(c.max);
  return `<svg class="comp-svg" viewBox="0 0 ${n * 50 + 2} 46" role="img" aria-label="${txt} ${capsula ? 'cápsula(s)' : 'comprimido(s)'}">${itens}</svg>
  <div class="visual-legenda">${c.max % 1 ? 'Partir o comprimido ao meio (somente se for sulcado/fracionável) · ' : ''}<b>${txt.replace('.5', '½')} ${capsula ? 'cápsula(s)' : 'comprimido(s)'}</b> por dose</div>`;
}
function visualDoseHTML(form, valorTexto){
  let html = '';
  if((form.tipo === 'liquido' || form.tipo === 'injetavel') && form.concentracaoMgMl){
    const ml = _parseML(valorTexto);
    if(ml) html = seringaSVG(ml, form.tipo === 'injetavel');
  } else if(form.tipo === 'comprimido'){
    const c = _parseComp(valorTexto);
    if(c) html = comprimidosSVG(c, /c[aá]psula/i.test(form.rotulo || '') || form.unidadeComprimido === 'cápsula');
  }
  return html ? `<div class="visual-dose tipo-${form.tipo}">${html}</div>` : '';
}

// ---------- Teto diário ----------
function tetoDiarioHTML(ctx){
  const { f, dose, db, da, regimeUsado, idadeBloqueada } = ctx;
  if(!dose || idadeBloqueada) return '';
  let vezes = null, teto = null, rot = '';
  if(regimeUsado === 'adulto' && da){
    vezes = da.vezesDia || null;
    teto = da.doseMaximaDiaMg || f.doseMaximaDiaAdultoMg || null;
    rot = 'dose máxima diária de adulto';
  } else if(db.tipo === 'mgkg_dia'){
    vezes = db.fracionamento || 1;
    teto = db.doseMaximaDiaMg || f.doseMaximaDiaAdultoMg || null;
    rot = db.doseMaximaDiaMg ? 'dose máxima diária' : 'dose máxima diária de adulto';
  } else if(db.tipo === 'mgkg_dose' && db.vezesDia){
    vezes = db.vezesDia;
    teto = db.doseMaximaDiaMg || (db.doseMaximaDoseMg ? db.doseMaximaDoseMg * db.vezesDia : null) || f.doseMaximaDiaAdultoMg || null;
    rot = 'dose máxima diária';
  }
  if(!vezes || !teto) return '';
  const dMin = dose.min * vezes, dMax = dose.max * vezes;
  const pct = Math.min(100, Math.round(dMax / teto * 100));
  const pctMin = Math.min(100, Math.round(dMin / teto * 100));
  const nivel = pct >= 100 ? 'no-teto' : pct >= 80 ? 'perto' : 'ok';
  const msg = dose.capApplied ? 'Limitada ao teto: o cálculo por peso ultrapassaria a dose máxima' : pct >= 100 ? 'A dose maior da faixa atinge o teto diário' : pct >= 80 ? 'Próximo do teto diário' : 'Dentro da margem de segurança';
  return `<div class="teto-box teto-${nivel}">
    <div class="teto-topo">
      <span class="teto-titulo">Dose diária × teto</span>
      <span class="teto-status">${msg}</span>
    </div>
    <div class="teto-barra" role="img" aria-label="${pct}% da ${rot}">
      <span class="teto-faixa" style="left:${pctMin}%;width:${Math.max(pct - pctMin, 0)}%"></span>
      <span class="teto-cheio" style="width:${pctMin}%"></span>
    </div>
    <div class="teto-legenda">
      <span><b>${dMin === dMax ? formatarMg(arred(dMax)) : formatarMg(arred(dMin)) + '–' + formatarMg(arred(dMax))}</b>/dia (${vezes}× ao dia)</span>
      <span>${pctMin === pct ? pct : pctMin + '–' + pct}% da ${rot} (<b>${formatarMg(teto)}</b>)</span>
    </div>
  </div>`;
}

// ---------- Etiqueta de posologia ----------
const ETQ_PROF_KEY = 'fp-etiqueta-profissional';
let _etqCtx = null;
function _intervaloHoras(via){
  const t = (via || '').toLowerCase();
  let m = t.match(/a cada (\d+(?:[.,]\d+)?)\s*(?:h\b|hora)/);
  if(m) return parseFloat(m[1].replace(',', '.'));
  m = t.match(/(\d+)\s*(?:x|vezes)\s*(?:ao|por)\s*dia/);
  if(m) return 24 / parseInt(m[1], 10);
  if(/(1|uma)\s*vez\s*(ao|por)\s*dia|1x\/dia/.test(t)) return 24;
  return null;
}
function _horarios(inicio, intervalo){
  if(!intervalo || !inicio || intervalo < 4 || 24 % intervalo) return '';
  const [h, mi] = inicio.split(':').map(Number);
  const out = [];
  for(let k = 0; k < 24 / intervalo; k++){
    const hh = (h + k * intervalo) % 24;
    out.push(String(hh).padStart(2, '0') + ':' + String(mi || 0).padStart(2, '0'));
  }
  return out.join(' · ');
}
function abrirEtiqueta(ctx){
  _etqCtx = ctx;
  let prof = {};
  try{ prof = JSON.parse(localStorage.getItem(ETQ_PROF_KEY) || '{}'); }catch(e){}
  const v = id => document.getElementById(id);
  v('etq-paciente').value = '';
  v('etq-dose').value = _decBR(textoPlano(ctx.valorTexto));
  v('etq-via').value = textoPlano(ctx.form.viaTexto || '');
  const agora = new Date(); const prox = (agora.getHours() + 1) % 24;
  v('etq-inicio').value = String(prox).padStart(2, '0') + ':00';
  v('etq-dias').value = '';
  v('etq-obs').value = '';
  v('etq-prof').value = prof.nome || '';
  v('etq-drogaria').value = prof.drogaria || '';
  v('etq-formato').value = prof.formato || 'etiqueta';
  v('etq-crf').value = prof.crf || '';
  atualizarEtiqueta();
  document.getElementById('etiqueta-overlay').classList.add('aberto');
  setTimeout(() => v('etq-paciente').focus(), 50);
}
function fecharEtiqueta(){ document.getElementById('etiqueta-overlay').classList.remove('aberto'); }
function atualizarEtiqueta(){
  if(!_etqCtx) return;
  const val = id => (document.getElementById(id).value || '').trim();
  const { f, form } = _etqCtx;
  const dose = val('etq-dose'), via = val('etq-via');
  const intervalo = _intervaloHoras(via);
  const hor = _horarios(val('etq-inicio'), intervalo);
  const dias = val('etq-dias');
  const faixa = /–|-\s*\d|\ba\s+\d/.test(dose);
  document.getElementById('etq-aviso-faixa').hidden = !faixa;
  const hoje = new Date().toLocaleDateString('pt-BR');
  const nomeProf = val('etq-prof'), crf = val('etq-crf');
  const drog = val('etq-drogaria'), fmt = document.getElementById('etq-formato').value;
  const prev = document.getElementById('etiqueta-preview');
  prev.className = 'fmt-' + fmt;
  document.getElementById('etq-prev-titulo').textContent = 'Prévia (' + ({ etiqueta:'90 × 50 mm', cupom80:'cupom 80 mm', cupom58:'cupom 58 mm' })[fmt] + ')';
  document.getElementById('etq-dica-cupom').hidden = fmt === 'etiqueta';
  prev.innerHTML = `
    <div class="etq-cab">${drog ? `<span class="etq-drog">${escapeHtml(drog)}</span>` : '<span class="etq-marca">Farma<b>Prática</b></span>'}<span>${hoje}</span></div>
    ${val('etq-paciente') ? `<div class="etq-paciente">${escapeHtml(val('etq-paciente'))}</div>` : '<div class="etq-paciente etq-vazio">Paciente: ______________________</div>'}
    <div class="etq-med">${escapeHtml(f.nome)}</div>
    <div class="etq-apres">${escapeHtml(form.rotulo)}</div>
    <div class="etq-dose">Tomar <b>${escapeHtml(dose || '—')}</b>${via ? ' ' + escapeHtml(via) : ''}</div>
    ${hor ? `<div class="etq-linha"><span>Horários</span><b>${hor}</b></div>` : ''}
    ${dias ? `<div class="etq-linha"><span>Duração</span><b>${escapeHtml(dias)} dia${dias === '1' ? '' : 's'}</b></div>` : ''}
    ${val('etq-obs') ? `<div class="etq-obs">${escapeHtml(val('etq-obs'))}</div>` : ''}
    ${(nomeProf || crf) ? `<div class="etq-prof">Farm. ${escapeHtml(nomeProf)}${crf ? ' · ' + escapeHtml(crf) : ''}</div>` : ''}
  `;
}
function imprimirEtiqueta(){
  const fmt = document.getElementById('etq-formato').value;
  try{ localStorage.setItem(ETQ_PROF_KEY, JSON.stringify({ nome: document.getElementById('etq-prof').value.trim(), crf: document.getElementById('etq-crf').value.trim(), drogaria: document.getElementById('etq-drogaria').value.trim(), formato: fmt })); }catch(e){}
  const area = document.getElementById('etiqueta-print-area');
  area.innerHTML = `<div class="etiqueta-papel fmt-${fmt}">${document.getElementById('etiqueta-preview').innerHTML}</div>`;
  document.body.classList.add('imprimindo-etiqueta');
  // Tamanho da página: cupom térmico usa a largura da bobina e a altura exata do conteúdo (corte logo após o texto)
  let pg = document.getElementById('etq-page-style');
  if(!pg){ pg = document.createElement('style'); pg.id = 'etq-page-style'; document.head.appendChild(pg); }
  if(fmt === 'etiqueta'){ pg.textContent = '@media print{ @page{ size:auto; margin:8mm; } }'; }
  else {
    const largura = fmt === 'cupom58' ? 58 : 80;
    const prevEl = document.getElementById('etiqueta-preview');
    const alturaMm = Math.ceil(prevEl.scrollHeight * 25.4 / 96 * (fmt === 'cupom58' ? 48 : 72) / (prevEl.offsetWidth * 25.4 / 96 || 1)) + 12;
    pg.textContent = '@media print{ @page{ size:' + largura + 'mm ' + Math.max(alturaMm, 60) + 'mm; margin:0; } }';
  }
  const limpar = () => { document.body.classList.remove('imprimindo-etiqueta'); area.innerHTML = ''; window.removeEventListener('afterprint', limpar); };
  window.addEventListener('afterprint', limpar);
  window.print();
  setTimeout(() => { if(document.body.classList.contains('imprimindo-etiqueta') && !matchMedia('print').matches) limpar(); }, 1500);
}
(function initEtiqueta(){
  const ov = document.getElementById('etiqueta-overlay');
  if(!ov) return;
  ov.addEventListener('click', e => { if(e.target === ov) fecharEtiqueta(); });
  document.getElementById('etiqueta-fechar').addEventListener('click', fecharEtiqueta);
  document.getElementById('etq-imprimir').addEventListener('click', imprimirEtiqueta);
  ov.querySelectorAll('input, textarea, select').forEach(el => { el.addEventListener('input', atualizarEtiqueta); el.addEventListener('change', atualizarEtiqueta); });
  document.addEventListener('keydown', e => { if(e.key === 'Escape' && ov.classList.contains('aberto')) fecharEtiqueta(); });
})();

function arred(n){ return Math.round(n * 100) / 100; }

function arredondarMeio(n){ return Math.round(n * 2) / 2; }

function formatarComprimidos(n){
  if(n === 1) return '1 comprimido';
  if(n % 1 === 0) return `${n} comprimidos`;
  const inteiro = Math.floor(n);
  const sufixo = inteiro > 0 ? `${inteiro}½` : '½';
  return `${sufixo} comprimido${n > 1 ? 's' : ''}`;
}

function formatarMg(mg){
  if(mg >= 1000) return `${arred(mg/1000)} g`;
  return `${mg} mg`;
}

function formatarIdadeMinima(meses){
  if(meses < 12) return meses + ' meses';
  const anos = meses / 12;
  return (anos % 1 === 0 ? anos : anos.toFixed(1)) + ' anos';
}
</script>

<script src="../assets/tempo-uso.js" data-tool="calc"></script>
</body>
</html>
