<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/x-icon" href="data:image/x-icon;base64,">
<title>FarmaPrática | Calculadora de Doses</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    /* Paleta grafite médio/escuro — mesmo tom usado no Medicamentos Equivalentes */
    --header: linear-gradient(180deg, color-mix(in srgb, #2b2d31 84%, #000 10%) 0%, color-mix(in srgb, #2b2d31 88%, #000 14%) 100%);
    --bg: #34363a;
    --panel: #35373c;
    --sidebar: #221f24;
    --card: #38383e;
    --card-hover: #414247;
    --border: #48494f;
    --red-dark: #a10f1f;
    --red: #e4172c;
    --red-bright: #e4172c;
    --red-glow: rgba(228,23,44,0.22);
    --text: #f5f5f4;
    --text-dim: #a7abb1;
    --text-gray: #d2d5d9;
    --amber: #f59e0b;
    --pill-bg: #33232a;
    --pill-text: #f6cf74;
    --sidebar-w: 292px;
    --hover-tint: rgba(255,255,255,.06);
  }

  /* ---------- Tema claro ---------- */
  body.light{
    --header: linear-gradient(180deg, #dfe2e6 0%, #d3d7dc 100%);
    --bg: #eceef1;
    --panel: #f6f7f9;
    --sidebar: #e2e5e9;
    --card: #ffffff;
    --card-hover: #f1f2f5;
    --border: #d7dade;
    --red-dark: #a10f1f;
    --red: #d4152a;
    --red-bright: #d4152a;
    --red-glow: rgba(212,21,42,0.14);
    --text: #22262c;
    --text-dim: #767c84;
    --text-gray: #4b5057;
    --amber: #c9790a;
    --pill-bg: #fbe9ea;
    --pill-text: #a10f1f;
    --hover-tint: rgba(20,20,30,.05);
  }
  body.light .empty-icon{ background: linear-gradient(135deg, rgba(161,15,31,.1), rgba(168,106,6,.1)); }
  body.light .valor-pill{ background: linear-gradient(135deg, #fdf0d8, var(--pill-bg)); border-color: rgba(161,15,31,.22); }
  body.light .peso-bar{ background: linear-gradient(135deg, rgba(161,15,31,.05), rgba(168,106,6,.04)); }
  body.light .theme-toggle .icon-sun{ display:none; }
  body.light .theme-toggle .icon-moon{ display:block; }
  body.light .formulacao{ box-shadow: 0 2px 10px rgba(23,26,32,.06); }
  body.light{ background: var(--bg); }
  *{ box-sizing: border-box; }
  html,body{ height:100%; }
  body{
    margin:0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--text);
    display:flex;
    flex-direction: column;
    height:100vh;
    overflow:hidden;
    transition: background-color .2s ease, color .2s ease;
    position: relative;
  }

  /* ---------- Modo Pediátrico: leve tingimento "bebê" da página inteira ----------
     Aplicado via body.modo-pediatrico (idade < 18 anos informada). Usa uma camada
     translúcida fixa (não interfere no layout/cores de cada componente individualmente,
     por isso funciona igual nos temas claro e escuro) que aparece/desaparece com
     transição suave conforme a idade digitada cruza o limiar de 18 anos. */
  body::after{
    content:'';
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:4;
    background:
      radial-gradient(circle at 12% -4%, rgba(79,143,209,.16), transparent 55%),
      linear-gradient(180deg, rgba(79,143,209,.05), rgba(79,143,209,.02) 45%, transparent 75%);
    opacity:0;
    transition: opacity .35s ease;
  }
  body.modo-pediatrico::after{ opacity:1; }
  @media print{ body::after{ display:none !important; } }

  /* ---------- Topbar ---------- */
  .topbar-app{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 24px;
    min-height: 84px;
    flex-shrink:0;
    padding: 20px 40px;
    background: var(--header);
    border-bottom: 2px solid #e4172c;
    position: relative;
    border-radius: 0 0 20px 20px;
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.07),
      0 1px 0 rgba(0,0,0,.35),
      0 20px 34px -18px rgba(0,0,0,.65),
      0 8px 16px -8px rgba(0,0,0,.45);
    z-index: 3;
  }
  body.light .topbar-app{
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.85),
      0 1px 0 rgba(15,23,42,.06),
      0 20px 34px -20px rgba(15,23,42,.26),
      0 8px 16px -10px rgba(15,23,42,.13);
  }
  .theme-toggle{
    display:flex;
    align-items:center;
    justify-content:center;
    width:40px;
    height:40px;
    border-radius:9px;
    border:1px solid var(--border);
    background:transparent;
    color:var(--text);
    cursor:pointer;
    flex-shrink:0;
    box-shadow: 0 1px 4px rgba(0,0,0,.16);
    transition: background-color .15s ease, border-color .15s ease, box-shadow .15s ease;
  }
  body.light .theme-toggle{ box-shadow: 0 1px 3px rgba(23,26,32,.08); }
  .theme-toggle:hover{ background: var(--hover-tint); box-shadow: 0 3px 10px rgba(0,0,0,.22); }
  body.light .theme-toggle:hover{ box-shadow: 0 3px 10px rgba(23,26,32,.12); }
  .theme-toggle svg{ width:18px; height:18px; }
  .theme-toggle .icon-moon{ display:none; }
  .topbar-app .logo-wrap{
    display:flex;
    align-items:center;
    flex-shrink:0;
  }
  .topbar-app .logo-wrap a{
    display:flex;
    align-items:center;
    text-decoration:none;
    color:inherit;
  }
  /* 27/08/2026: botão "início" exclusivo do cabeçalho mobile — oculto por padrão,
     só aparece dentro do @media(max-width:800px) abaixo (mesmo padrão já usado
     no Checklist de Rotina). */
  .topbar-home-mobile{ display:none; }
  .home-btn-desktop{ display:flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:9px; border:1px solid var(--border); background:transparent; color:var(--text); cursor:pointer; text-decoration:none; transition:background-color .15s ease,border-color .15s ease; flex-shrink:0; }
  .home-btn-desktop:hover{ background:var(--hover-tint); border-color:var(--red); }
  .home-btn-desktop svg{ width:18px; height:18px; }
  .brand{
    display:flex;
    align-items:center;
    gap:14px;
  }
  .brand img{
    width:50px;
    height:50px;
  }
  .brand-text h1{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    font-size:25px;
    font-weight:800;
    letter-spacing:-0.3px;
    line-height:1.1;
    margin:0;
    color: var(--text);
    white-space:nowrap;
    text-shadow: 0 2px 16px rgba(0,0,0,.5);
  }
  body.light .brand-text h1{ text-shadow: 0 1px 8px rgba(0,0,0,.12); }
  .brand-text h1 span{ color:var(--red); }
  .brand-text p{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    font-size:12.5px;
    color:var(--text-gray);
    font-weight:400;
    margin:2px 0 0;
    white-space:nowrap;
    text-shadow: 0 1px 8px rgba(0,0,0,.35);
  }
  body.light .brand-text p{ text-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .topbar-app .titulo-central{
    flex:1;
    min-width:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
  }
  .topbar-app .titulo-principal{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    font-size: 1rem;
    font-weight:800;
    white-space:nowrap;
    letter-spacing:.4px;
    line-height:1.25;
    color: var(--text);
    text-shadow: 0 1px 0 rgba(0,0,0,.45), 0 4px 14px rgba(0,0,0,.38);
  }
  .topbar-app .titulo-principal .titulo-accent{
    color: var(--text);
    text-shadow: 0 1px 0 rgba(0,0,0,.45), 0 4px 14px rgba(0,0,0,.38);
  }
  body.light .topbar-app .titulo-principal{
    text-shadow: 0 1px 0 rgba(255,255,255,.6), 0 2px 6px rgba(23,26,32,.18);
  }
  body.light .topbar-app .titulo-principal .titulo-accent{
    text-shadow: 0 1px 0 rgba(255,255,255,.6), 0 2px 6px rgba(23,26,32,.18);
  }
  .topbar-app .titulo-descricao{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    font-size: .74rem;
    color: var(--text-dim);
    margin-top:2px;
    white-space:nowrap;
  }
  .calc-count-badge{
    display:inline-flex; align-items:center; gap:6px; margin-top:7px;
    padding:3px 11px; border-radius:999px;
    background:var(--red-glow); border:1px solid rgba(228,23,44,.35);
    color:var(--red-bright); font-size:.72rem; font-weight:700; letter-spacing:.02em;
  }
  .calc-count-badge svg{ width:13px; height:13px; }

  @media (max-width: 800px){
    /* 27/08/2026: cabeçalho mobile reformulado para seguir o mesmo padrão já
       aprovado no Checklist de Rotina — a marca (logo+"FarmaPrática") some
       completamente do mobile, e um botão circular de "início"
       (.topbar-home-mobile) no canto superior esquerdo assume a função de
       navegação que o logo tinha. */
    .topbar-app{ flex-wrap:wrap; justify-content:center; gap:8px; padding: 10px 14px; position:relative; }
    .topbar-app .logo-wrap{ display:none; }
    .home-btn-desktop{ display:none; }
    .topbar-home-mobile{
      display:flex; align-items:center; justify-content:center;
      position:absolute; left:14px; top:10px;
      width:34px; height:34px; border-radius:9px;
      border:1px solid var(--border); background:var(--panel);
      color:var(--text-dim); text-decoration:none; z-index:2;
    }
    .topbar-home-mobile svg{ width:17px; height:17px; }
    .topbar-home-mobile:hover{ color:var(--text); border-color:var(--red); }
    /* Título+descrição: volta ao fluxo normal, com respiro simétrico dos dois
       lados para não colidir com o botão de início. */
    .topbar-app .titulo-central{ flex-basis:100%; padding:0 44px; }
    .topbar-app .titulo-principal{ white-space:normal; }
    .topbar-app .titulo-descricao{ white-space:normal; }
    /* Botão de tema: sai do canto fixo (regra antiga tinha position:absolute) e
       volta ao fluxo normal do flex — como o título acima ocupa a linha
       inteira (flex-basis:100%), o botão fica sozinho na linha seguinte e
       `justify-content:center` do .topbar-app já o centraliza, sem precisar de
       nenhum ícone flutuando em canto fixo (mesmo padrão do Checklist de
       Rotina). */
  }

  .app-body{
    display:flex;
    flex:1;
    min-height:0;
  }

  /* ---------- Sidebar ---------- */
  .sidebar{
    width: var(--sidebar-w);
    flex-shrink:0;
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    display:flex;
    flex-direction:column;
    height:100%;
    box-shadow: 4px 0 24px -8px rgba(0,0,0,.35);
    z-index: 2;
    transition: box-shadow .25s ease;
  }
  .sidebar:hover{ box-shadow: 4px 0 32px -8px rgba(0,0,0,.5); }
  .sidebar-header{
    padding: 18px 16px 14px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 6px;
  }
  .search-box{
    display:flex;
    align-items:center;
    gap:9px;
    background: var(--card);
    border:1px solid var(--border);
    border-radius:13px;
    padding: 10px 14px;
    box-shadow: 0 1px 2px rgba(0,0,0,.08);
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .search-box:focus-within{
    border-color: var(--red-bright);
    box-shadow: 0 0 0 3px var(--red-glow);
  }
  .search-box input{
    background:transparent;
    border:none;
    outline:none;
    color:var(--text);
    font-size:.85rem;
    font-family: inherit;
    width:100%;
  }
  .search-box input::placeholder{ color: rgba(245,245,244,.62); opacity:1; }
  body.light .search-box input::placeholder{ color: var(--text-dim); opacity:1; }
  .sidebar-list{
    flex:1;
    overflow-y:auto;
    overflow-x:hidden;
    padding: 6px 12px 20px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .sidebar-list::-webkit-scrollbar{ width:6px; }
  .sidebar-list::-webkit-scrollbar-track{ background:transparent; }
  .sidebar-list::-webkit-scrollbar-thumb{ background: var(--border); border-radius:10px; }
  .cat-header{
    font-size:.66rem;
    text-transform:uppercase;
    letter-spacing:1.1px;
    color: var(--text);
    font-weight:800;
    opacity:.95;
    transition: background-color .5s ease, color .5s ease;
  }
  .cat-group{ margin-top: 18px; }
  .cat-group:first-child{ margin-top: 6px; }
  /* 05/11/2026: reskin total do item de fármaco inspirado no cartão de termo
     (.quick-card) do Dicionário Farmacêutico — ponto colorido por categoria
     (.drug-dot) + rótulo, cantos mais arredondados e cartão mais "plano"
     (var(--panel) sólido), mantendo a estrutura/funcionamento idênticos
     (clique seleciona o fármaco, estado .active, destaque de busca via
     <mark>). Nenhuma mudança de HTML fora de criarBotaoFarmaco(). */
  .drug-item{
    display:flex;
    align-items:center;
    gap:9px;
    width:100%;
    text-align:left;
    background: var(--panel);
    border: 1px solid var(--border);
    border-left: 3px solid transparent;
    color: var(--text-gray);
    font-size:.85rem;
    font-family: inherit;
    padding: 8px 12px 8px 11px;
    border-radius:10px;
    cursor:pointer;
    margin: 0 0 6px;
    box-shadow: 0 1px 3px rgba(0,0,0,.16), inset 0 1px 0 0 rgba(255,255,255,.08), inset 0 -3px 7px 0 rgba(0,0,0,.3);
    transition: background-color .15s ease, color .15s ease, border-color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  body.light .drug-item{ box-shadow: 0 1px 2px rgba(35,40,48,.05), inset 0 1px 0 0 rgba(255,255,255,.6), inset 0 -2px 5px 0 rgba(35,40,48,.05); }
  .drug-item .drug-dot{
    width:7px;height:7px;border-radius:50%;flex-shrink:0;
    background:linear-gradient(145deg, var(--cat-accent, var(--text-dim)), color-mix(in srgb, var(--cat-accent, var(--text-dim)) 55%, transparent));
    box-shadow:0 0 5px 1px color-mix(in srgb, var(--cat-accent, var(--text-dim)) 55%, transparent), inset 0 1px 1px rgba(255,255,255,.4);
    transition: transform .18s ease;
  }
  .drug-item .drug-label{ min-width:0; }
  .drug-item:hover{ background: var(--card-hover); color: var(--text); border-color: var(--red-bright); box-shadow: 0 6px 16px rgba(0,0,0,.3), inset 0 1px 0 0 rgba(255,255,255,.12), inset 0 -3px 8px 0 rgba(0,0,0,.35); transform: translateY(-1px); }
  body.light .drug-item:hover{ box-shadow: 0 6px 16px rgba(35,40,48,.13), inset 0 1px 0 0 rgba(255,255,255,.7), inset 0 -2px 6px 0 rgba(35,40,48,.07); }
  .drug-item:hover .drug-dot{ transform:scale(1.2); }
  .drug-item:active{ transform: translateY(0) scale(.98); }
  .drug-item.active{
    background: var(--red-glow);
    color: var(--red-bright);
    border-color: var(--red-bright);
    border-left-color: var(--red-bright);
    font-weight:700;
  }

  /* ---------- Main ---------- */
  .main{
    flex:1;
    display:flex;
    flex-direction: column;
    align-items:center;
    padding: 26px 40px 60px;
    overflow-y:auto;
    height:100%;
  }
  .main-inner{
    width:100%;
    max-width: 1000px; /* 08/11/2026: alinhado com .resultado-grid (abaixo) para que o
      cabeçalho/breadcrumb/dados do paciente tenham a mesma largura das caixas de
      posologia e observações, dando aparência de coluna única — pedido do usuário */
  }
  .main-header{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .main-header h2{
    margin:0;
    font-size: 1.75rem;
    letter-spacing:-.2px;
  }
  .main-header .cat-tag{
    display:inline-block;
    font-size:.68rem;
    text-transform:uppercase;
    letter-spacing:.6px;
    font-weight:800;
    color: var(--amber);
    background: rgba(232,184,75,.08);
    border: 1px solid rgba(232,184,75,.3);
    padding: 3px 10px;
    border-radius: 20px;
    margin-top:8px;
  }
  .main-header-actions{
    display:flex;
    align-items:center;
    gap:8px;
  }
  .btn-mobile-voltar{
    display:none;
    align-items:center;
    gap:6px;
    background:transparent;
    border:1px solid var(--border);
    color:var(--text-dim);
    font-size:.78rem;
    font-weight:700;
    padding:8px 14px;
    border-radius:20px;
    cursor:pointer;
    margin-bottom:14px;
    box-shadow: 0 1px 3px rgba(0,0,0,.12);
    transition: background .15s, color .15s, border-color .15s;
  }
  .btn-mobile-voltar .icon{ width:13px; height:13px; }
  .btn-mobile-voltar:hover{ background: var(--hover-tint); color: var(--text); border-color: var(--text-dim); }
  .breadcrumb-chip{
    display:inline-flex;
    align-items:center;
    gap:4px;
    font-size:.68rem;
    text-transform:uppercase;
    letter-spacing:.6px;
    font-weight:800;
    color: var(--amber);
    background: rgba(232,184,75,.08);
    border: 1px solid rgba(232,184,75,.3);
    padding: 4px 12px 4px 8px;
    border-radius: 20px;
    margin-bottom:10px;
    cursor:pointer;
    box-shadow: 0 1px 4px rgba(168,106,6,.14);
    transition: background .15s, transform .1s, box-shadow .15s;
  }
  .breadcrumb-chip .icon{ width:11px; height:11px; }
  .breadcrumb-chip:hover{ background: rgba(232,184,75,.16); transform: translateX(-2px); box-shadow: 0 3px 10px rgba(168,106,6,.22); }
  .main-header h2{ margin-top:0; }
  .farmaco-descricao{
    margin: 8px 0 0;
    font-size:.86rem;
    line-height:1.5;
    color: var(--text-gray);
    max-width: 60ch;
  }
  .secao-titulo{
    display:flex;
    align-items:center;
    gap:7px;
    font-size:.72rem;
    text-transform:uppercase;
    letter-spacing:.8px;
    font-weight:800;
    color: var(--text-dim);
    margin: 4px 0 10px;
  }
  .secao-titulo .icon{ width:13px; height:13px; color: var(--red-bright); }
  .cat-header.destacado{ background: var(--red-glow); color: var(--red-bright); }
  .btn-fav-calc{
    display:inline-flex;align-items:center;justify-content:center;
    width:34px;height:34px;padding:0;
    border:1px solid var(--red-bright);
    color:var(--red-bright);
    background: color-mix(in srgb, var(--red-bright) 8%, var(--card));
    border-radius:50%;
    cursor:pointer;
    box-shadow: 0 2px 8px rgba(180,25,42,.22), inset 0 1px 0 0 rgba(255,255,255,.1);
    transition:all .15s;
    flex-shrink:0;
  }
  .btn-fav-calc svg{width:16px;height:16px;display:block;}
  .btn-fav-calc:hover{background:rgba(200,19,40,.16); box-shadow: 0 6px 16px rgba(180,25,42,.32); transform: translateY(-2px);}
  .btn-fav-calc:active{ transform: translateY(0) scale(.92); }
  .btn-fav-calc.starred{background:var(--red-bright);color:#fff;}
  .btn-bula{
    display:inline-flex;
    align-items:center;
    gap:6px;
    border: 1px solid var(--red-bright);
    color: var(--red-bright);
    background: color-mix(in srgb, var(--red-bright) 7%, var(--card));
    padding: 8px 18px;
    border-radius: 20px;
    font-size:.8rem;
    font-weight:700;
    cursor:pointer;
    text-decoration:none;
    white-space:nowrap;
    box-shadow: 0 3px 10px rgba(180,25,42,.2), inset 0 1px 0 0 rgba(255,255,255,.1);
    transition: background .15s, transform .1s, box-shadow .15s;
  }
  .btn-bula:hover{ background: rgba(239,45,64,.14); transform: translateY(-2px); box-shadow: 0 7px 18px rgba(180,25,42,.3); }
  .btn-bula:active{ transform: translateY(0) scale(.96); }

  .btn-nomes-comerciais{
    display:inline-flex;
    align-items:center;
    gap:6px;
    border: 1px solid var(--border);
    color: var(--text-dim);
    background: var(--card);
    padding: 8px 16px;
    border-radius: 20px;
    font-size:.8rem;
    font-weight:700;
    cursor:pointer;
    white-space:nowrap;
    box-shadow: 0 2px 8px rgba(0,0,0,.14), inset 0 1px 0 0 rgba(255,255,255,.08);
    transition: background .15s, color .15s, border-color .15s, box-shadow .15s, transform .1s;
  }
  body.light .btn-nomes-comerciais{ box-shadow: 0 1px 3px rgba(23,26,32,.07), inset 0 1px 0 0 rgba(255,255,255,.6); }
  .btn-nomes-comerciais .icon{ width:13px; height:13px; }
  .btn-nomes-comerciais:hover{ background: var(--hover-tint); color: var(--text); border-color: var(--text-dim); box-shadow: 0 6px 16px rgba(0,0,0,.2); transform: translateY(-2px); }
  body.light .btn-nomes-comerciais:hover{ box-shadow: 0 6px 16px rgba(23,26,32,.12); }
  .btn-nomes-comerciais:active{ transform: translateY(0) scale(.96); }

  /* ---------- Modal de nomes comerciais ---------- */
  .comerciais-overlay{
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.6);
    backdrop-filter: blur(3px);
    display:none;
    align-items:center;
    justify-content:center;
    z-index: 1000;
    padding: 20px;
  }
  .comerciais-overlay.aberto{ display:flex; }
  .comerciais-modal{
    width:100%;
    max-width: 440px;
    max-height: 80vh;
    overflow-y:auto;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 30px 80px rgba(0,0,0,.5);
  }
  .comerciais-header{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:10px;
    padding: 16px 18px 14px 20px;
    border-bottom: 1px solid var(--border);
  }
  .comerciais-header h3{
    margin:0;
    font-size:1rem;
    font-weight:800;
    line-height:1.35;
  }
  .comerciais-fechar{
    display:inline-flex;align-items:center;justify-content:center;
    width:28px;height:28px;
    flex-shrink:0;
    border:none;
    background:transparent;
    color:var(--text-dim);
    cursor:pointer;
    border-radius:50%;
    transition: background .15s, color .15s;
  }
  .comerciais-fechar .icon{ width:14px; height:14px; }
  .comerciais-fechar:hover{ background: var(--hover-tint); color:var(--text); }
  .comerciais-body{ padding: 16px 20px 20px; }
  .comerciais-lista{
    list-style:none; margin:0 0 14px; padding:0;
    display:flex; flex-direction:column; gap:8px;
  }
  .comerciais-lista li{
    display:flex; align-items:center; gap:8px;
    padding: 9px 12px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size:.85rem;
    font-weight:600;
    color: var(--text);
  }
  .comerciais-lista li .icon{ width:13px; height:13px; color: var(--amber); flex-shrink:0; }
  .comerciais-aviso{
    font-size:.72rem;
    line-height:1.55;
    color: var(--text-dim);
    border-top: 1px solid var(--border);
    padding-top:12px;
    margin:0;
  }

  .peso-bar{
    background: linear-gradient(135deg, rgba(180,25,42,.1), rgba(232,184,75,.05));
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px 22px;
    display:flex;
    gap: 32px;
    align-items:center;
    margin-bottom: 28px;
  }
  .peso-field{ display:flex; align-items:center; gap:10px; }
  .peso-field .field-icon{
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(239,45,64,.12);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size: 1rem;
    flex-shrink:0;
  }
  .peso-field .field-inputs{ display:flex; flex-direction:column; gap:4px; }
  .peso-field label{ font-size:.7rem; color: var(--text-dim); font-weight:700; text-transform:uppercase; letter-spacing:.4px; }
  .peso-field .field-row{ display:flex; align-items:center; gap:8px; }
  .peso-field input{
    width: 84px;
    background: var(--panel);
    border:1px solid var(--border);
    border-radius:8px;
    color:var(--text);
    padding:7px 10px;
    font-size: 1rem;
    font-weight:600;
    outline:none;
    transition: border-color .15s, box-shadow .15s;
  }
  .peso-field input:focus{ border-color: var(--red-bright); box-shadow: 0 0 0 3px var(--red-glow); }
  .peso-field span{ font-size:.8rem; color: var(--text-dim); font-weight:600; }
  .unidade-toggle{
    display:flex;
    background: var(--panel);
    border:1px solid var(--border);
    border-radius:8px;
    overflow:hidden;
    box-shadow: 0 1px 3px rgba(0,0,0,.12);
  }
  body.light .unidade-toggle{ box-shadow: 0 1px 2px rgba(23,26,32,.06); }
  .unidade-toggle button{
    background:none;
    border:none;
    color: var(--text-dim);
    font-size:.72rem;
    font-weight:700;
    padding: 7px 11px;
    cursor:pointer;
    transition: background .15s, color .15s;
  }
  .unidade-toggle button.active{
    background: linear-gradient(135deg, var(--red-dark), var(--red));
    color:#fff;
  }

  @media (max-width: 560px){
    .peso-bar{ flex-wrap:wrap; gap:16px; }
  }

  /* ---------- Selo de tipo de paciente (Adulto / Pediátrico) ---------- */
  .tipo-paciente-banner{
    display:flex;
    align-items:center;
    gap:12px;
    border-radius:14px;
    padding:11px 18px;
    margin-bottom:18px;
    border:1px solid var(--border);
    background: var(--card);
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
    transition: background-color .25s ease, border-color .25s ease;
  }
  .tipo-paciente-banner[hidden]{ display:none; }
  .tipo-paciente-banner .tp-icon{
    width:36px; height:36px; border-radius:10px;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0; transition: background-color .25s ease, color .25s ease;
  }
  .tipo-paciente-banner .tp-icon .icon{ width:20px; height:20px; }
  .tipo-paciente-banner .tp-texto{ display:flex; flex-direction:column; gap:1px; min-width:0; }
  .tipo-paciente-banner .tp-label{ font-size:.86rem; font-weight:800; letter-spacing:.4px; transition: color .25s ease; }
  .tipo-paciente-banner .tp-sub{ font-size:.74rem; color:var(--text-dim); font-weight:600; }

  .tipo-paciente-banner.tp-adulto{ border-color: rgba(228,23,44,.35); }
  .tipo-paciente-banner.tp-adulto .tp-icon{ background: rgba(228,23,44,.12); color: var(--red-bright); }
  .tipo-paciente-banner.tp-adulto .tp-label{ color: var(--red-bright); }

  .tipo-paciente-banner.tp-pediatrico{ border-color: rgba(79,143,209,.4); }
  .tipo-paciente-banner.tp-pediatrico .tp-icon{ background: rgba(79,143,209,.16); color:#4f8fd1; }
  .tipo-paciente-banner.tp-pediatrico .tp-label{ color:#4f8fd1; }

  .tipo-paciente-banner.tp-transicao .tp-sub{ color:#c9790a; font-weight:700; }
  body.light .tipo-paciente-banner.tp-transicao .tp-sub{ color:#a8650a; }

  .empty-state{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding: 34px 20px 20px;
    color: var(--text-dim);
  }
  .empty-state .empty-icon{
    width: 72px;
    height: 72px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(180,25,42,.18), rgba(232,184,75,.1));
    border: 1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size: 2rem;
    margin-bottom: 18px;
  }
  .empty-state .empty-title{
    font-size: 1.05rem;
    font-weight:700;
    color: var(--text);
    margin-bottom: 6px;
  }
  .empty-state .empty-sub{
    font-size:.9rem;
    max-width: 360px;
    line-height:1.55;
    color: var(--text);
    font-weight:600;
  }

  .formulacoes-grid{
    display:flex;
    flex-direction:column;
    gap: 16px;
  }

  /* 08/11/2026: "Observações" deixou de ficar inline (empilhado, ocupando
     muita altura antes das formulações) e passou a ser uma coluna separada
     ao lado do texto das posologias — pedido do usuário. Em telas largas
     o suficiente (>=1040px de área útil), .resultado-grid vira grid de 2
     colunas (posologias + coluna de observações, esta fixada com
     position:sticky para acompanhar a rolagem); abaixo disso (tablet/mobile,
     sem espaço para 2 colunas), continua empilhado verticalmente na mesma
     ordem de antes (observações primeiro, por serem alertas de segurança). */
  .resultado-grid{
    width:100%;
    max-width: 1000px;
    margin: 18px auto 0;
    display:flex;
    flex-direction:column;
    gap: 20px;
  }
  .resultado-grid:empty{ display:none; }
  .resultado-principal{ min-width:0; }
  @media (min-width: 1040px){
    .resultado-grid{
      display:grid;
      grid-template-columns: minmax(0,1fr) 300px;
      grid-template-areas: "principal obs";
      align-items:start;
      gap: 26px;
    }
    .resultado-principal{ grid-area: principal; }
    #observacoes-container{ grid-area: obs; position:sticky; top:20px; }
  }

  .formulacao{
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 20px 22px;
    box-shadow: 0 4px 14px rgba(0,0,0,.18);
    transition: background-color .2s ease, border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }
  .formulacao:hover{ box-shadow: 0 8px 24px rgba(0,0,0,.22); transform: translateY(-1px); }
  body.light .formulacao:hover{ box-shadow: 0 8px 20px rgba(23,26,32,.1); }
  .formulacao .form-head{
    display:flex;
    align-items:center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .formulacao .form-icon{
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size: 1.05rem;
    flex-shrink:0;
  }
  .formulacao .form-icon.tipo-gotas{ background: rgba(127,168,201,.15); color:#7fa8c9; }
  .formulacao .form-icon.tipo-liquido{ background: rgba(74,180,150,.15); color:#4ab496; }
  .formulacao .form-icon.tipo-comprimido{ background: rgba(180,130,220,.15); color:#b482dc; }
  .formulacao .form-icon.tipo-injetavel{ background: rgba(239,45,64,.15); color: var(--red-bright); }
  .formulacao .form-icon.tipo-supositorio{ background: rgba(201,138,86,.18); color:#c98a56; }
  .formulacao h3{
    font-size: .95rem;
    margin: 0;
    font-weight:700;
    line-height:1.3;
  }
  .valor-pill{
    display:inline-block;
    background: linear-gradient(135deg, #4a3910, var(--pill-bg));
    color: var(--pill-text);
    font-weight:800;
    padding: 5px 14px;
    border-radius: 8px;
    font-size:.95rem;
    margin-right: 8px;
    border: 1px solid rgba(244,207,110,.25);
  }
  .formulacao .linha-principal{
    font-size:.88rem;
    margin-bottom: 12px;
    color: var(--text);
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap: 4px;
  }
  .sub-lista{
    list-style:none;
    margin:0;
    padding: 12px 0 0;
    border-top: 1px solid var(--border);
  }
  .sub-lista li{
    font-size:.8rem;
    color: var(--text-dim);
    padding: 4px 0 4px 16px;
    position:relative;
    line-height:1.5;
  }
  .sub-lista li::before{
    content: "•";
    position:absolute;
    left:0;
    color: var(--red-bright);
  }
  .sub-lista li.restricao{
    color: #f0a5a5;
  }
  .linha-principal.alerta-idade{
    color: #f0a5a5;
    font-weight:600;
    align-items:flex-start;
    background: rgba(240,165,165,.08);
    border: 1px solid rgba(240,165,165,.3);
    border-radius: 10px;
    padding: 10px 12px;
  }
  .linha-principal.alerta-idade .icon{
    flex-shrink:0;
    width:18px;
    height:18px;
    margin-top:1px;
  }
  .f-fixo{ color: var(--text); }
  .f-var{ color: #7fa8c9; }

  .instrucao-verbo{ color: var(--text-dim); font-weight:600; }

  .formula-details{ margin-top: 10px; }
  .formula-details summary{
    list-style:none;
    display:inline-flex;
    align-items:center;
    gap:5px;
    font-size:.72rem;
    font-weight:700;
    color: var(--text-dim);
    cursor:pointer;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    width:100%;
  }
  .formula-details summary::-webkit-details-marker{ display:none; }
  .formula-details summary .icon{ width:11px; height:11px; transition: transform .15s ease; }
  .formula-details[open] summary .icon{ transform: rotate(180deg); }
  .formula-details summary:hover{ color: var(--text); }
  .formula-content{
    margin-top: 10px;
    padding-left: 2px;
  }
  .formula-steps{
    list-style:none;
    margin:0;
    padding:0;
    display:flex;
    flex-direction:column;
    gap:8px;
    counter-reset: passo;
  }
  .formula-steps li{
    position:relative;
    counter-increment: passo;
    font-size:.76rem;
    line-height:1.55;
    color: var(--text-dim);
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius:8px;
    padding: 8px 10px 8px 32px;
  }
  .formula-steps li::before{
    content: counter(passo);
    position:absolute;
    left:8px;
    top:8px;
    width:16px;
    height:16px;
    border-radius:50%;
    background: var(--red-glow);
    color: var(--red-bright);
    font-size:.62rem;
    font-weight:800;
    display:flex;
    align-items:center;
    justify-content:center;
    line-height:1;
  }
  .formula-steps .f-fixo{ font-weight:700; }
  .formula-steps .f-var{
    display:block;
    margin-top:3px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size:.72rem;
  }

  .observacoes{
    margin-bottom: 20px;
    background: rgba(239,45,64,.05);
    border: 1px solid rgba(239,45,64,.2);
    border-radius: 16px;
    padding: 18px 20px;
  }
  .observacoes h3{
    color: var(--red-bright);
    font-size: .9rem;
    text-transform:uppercase;
    letter-spacing:.4px;
    margin: 0 0 14px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .obs-item{
    display:flex;
    gap:10px;
    align-items:flex-start;
    font-size:.85rem;
    color: var(--text-gray);
    margin-bottom: 12px;
    line-height:1.5;
  }
  .obs-item:last-child{ margin-bottom:0; }
  .obs-item .icon{
    color: var(--red-bright);
    flex-shrink:0;
    margin-top:1px;
    font-size:.8rem;
  }

  .fonte-tag{
    margin-top: 20px;
    display:inline-flex;
    align-items:center;
    gap: 6px;
    font-size: .74rem;
    color: var(--text-dim);
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: 20px;
  }
  .fonte-tag b{ color: var(--text); }

  /* ---------- Gate legal (tela obrigatória ao iniciar) ---------- */
  .gate-overlay{
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.75);
    backdrop-filter: blur(3px);
    display:flex;
    align-items:center;
    justify-content:center;
    z-index: 1000;
    padding: 20px;
  }
  .gate-modal{
    width: 100%;
    max-width: 540px;
    max-height: 88vh;
    overflow-y:auto;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: 0 30px 80px rgba(0,0,0,.6);
  }
  .gate-header{
    background: linear-gradient(120deg, var(--red-dark) 0%, #1a0505 100%);
    padding: 22px 26px;
    border-radius: 16px 16px 0 0;
  }
  .gate-header h2{
    margin:0 0 4px;
    font-size: 1.2rem;
    font-weight:800;
    color:#fff;
  }
  .gate-header p{
    margin:0;
    font-size: .8rem;
    color: rgba(255,255,255,.75);
  }
  .gate-body{
    padding: 22px 26px 24px;
  }
  .gate-body p{
    font-size: .82rem;
    line-height: 1.65;
    color: var(--text-gray);
    margin: 0 0 14px;
  }
  .gate-body p strong{ color: var(--text); }
  .gate-check{
    display:flex;
    align-items:flex-start;
    gap:10px;
    font-size: .8rem;
    line-height:1.5;
    color: var(--text);
    margin: 4px 0 18px;
    cursor:pointer;
  }
  .gate-check input{
    margin-top: 2px;
    width: 16px;
    height: 16px;
    flex-shrink:0;
    accent-color: var(--red-bright);
    cursor:pointer;
  }
  .gate-btn{
    width:100%;
    padding: 13px;
    border:none;
    border-radius: 8px;
    background: var(--border);
    color: rgba(255,255,255,.4);
    font-size: .95rem;
    font-weight:700;
    cursor:not-allowed;
    transition: background .15s, color .15s;
  }
  .gate-btn.ativo{
    background: linear-gradient(120deg, var(--red-bright), var(--red-dark));
    color:#fff;
    cursor:pointer;
    box-shadow: 0 4px 16px rgba(180,25,42,.35);
  }
  .gate-btn.ativo:hover{ filter: brightness(1.08); box-shadow: 0 6px 20px rgba(180,25,42,.45); }
  body.gate-aberto{ overflow:hidden; }
  body.gate-aberto .app-body{ filter: blur(2px); pointer-events:none; }

  .aviso-responsabilidade{
    width:100%;
    max-width: 1500px;
    margin: 14px auto 0;
    background: linear-gradient(160deg, rgba(228,23,44,.08), rgba(228,23,44,.02));
    border: 1px solid rgba(228,23,44,.35);
    border-radius: 14px;
    padding: 26px 32px;
  }
  .aviso-responsabilidade .aviso-titulo{
    display:flex;
    align-items:center;
    gap:8px;
    font-size: .95rem;
    font-weight:800;
    color: var(--red-bright);
    margin-bottom: 12px;
    letter-spacing:.2px;
  }
  .aviso-responsabilidade h4{
    font-size: .78rem;
    font-weight:700;
    color: var(--text);
    margin: 14px 0 4px;
    text-transform:uppercase;
    letter-spacing:.4px;
  }
  .aviso-responsabilidade h4:first-of-type{ margin-top:0; }
  .aviso-responsabilidade p{
    font-size: .78rem;
    line-height: 1.6;
    color: var(--text-gray);
    margin: 0 0 4px;
  }
  .aviso-responsabilidade ul{
    margin: 4px 0 4px;
    padding-left: 18px;
  }
  .aviso-responsabilidade li{
    font-size: .78rem;
    line-height: 1.6;
    color: var(--text-gray);
    margin-bottom: 3px;
  }
  .aviso-responsabilidade strong{ color: var(--text); }

  @media (max-width: 800px){
    .topbar-app{ padding: 8px 14px; }
    /* Marca FarmaPrática reduzida e discreta no mobile — o protagonismo passa a
       ser do título da própria ferramenta, não da marca (pedido do usuário). */
    .topbar-app .brand{ gap:7px; }
    .topbar-app .brand img{ width:24px; height:24px; }
    .topbar-app .brand-text h1{ font-size:13px; }
    .topbar-app .brand-text p{ font-size:7.5px; }
    .topbar-app .titulo-principal{
      font-size: 1.05rem;
      white-space:normal;
      margin-top:3px;
      text-shadow: 0 1px 0 rgba(0,0,0,.5), 0 6px 18px rgba(0,0,0,.45);
    }
    body.light .topbar-app .titulo-principal{
      text-shadow: 0 1px 0 rgba(255,255,255,.7), 0 3px 10px rgba(23,26,32,.22);
    }
    .topbar-app .titulo-descricao{ font-size: .64rem; white-space:normal; }
    /* Sidebar e conteúdo agora ocupam a tela inteira, uma vista por vez (ver bloco
       "Navegação mobile em vista única" mais abaixo), em vez de empilhar os dois
       com a sidebar limitada a 40vh acima do conteúdo. */
    .app-body{ flex-direction:column; min-height:0; }
    .sidebar{ width:100%; border-right:none; border-bottom:1px solid var(--border); }
    .main{ padding: 18px 16px 40px; }
    .main-inner{ max-width:100%; }
    .peso-bar{ flex-wrap:wrap; gap:14px; }
  }

  /* ---------- Ícones SVG utilitários ---------- */
  .icon{ width:1em; height:1em; display:inline-block; vertical-align:-0.14em; flex-shrink:0; }
  .icon svg{ width:100%; height:100%; display:block; }
  .search-box .icon{ width:15px; height:15px; color: var(--text-dim); }
  .field-icon .icon{ width:17px; height:17px; color: var(--red-bright); }
  .empty-icon .icon{ width:32px; height:32px; color: var(--red-bright); }
  .form-icon .icon{ width:23px; height:23px; }
  .aviso-titulo .icon{ width:16px; height:16px; }
  .obs-item .icon{ width:13px; height:13px; }
  .cat-chevron{ width:13px; height:13px; transition: transform .15s ease; flex-shrink:0; }
  .cat-header.colapsado .cat-chevron{ transform: rotate(-90deg); }

  /* ---------- Destaque de busca ---------- */
  mark{
    background: rgba(242,184,75,.35);
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }

  /* ---------- Cabeçalho de categoria (accordion) ----------
     05/11/2026: reskin total, inspirado no cartão de categoria (.cat-tile)
     do Dicionário Farmacêutico — cartão "plano" com cantos mais arredondados,
     selo de ícone com degradê (.cat-badge, equivalente ao .ct-icon de lá) em
     vez do pontinho solto, contador de itens (.cat-count-mini, equivalente ao
     .ct-count) e o brilho de hover passa a usar a cor da própria categoria
     (--cat-accent) em vez de um vermelho fixo — assim cada categoria "acende"
     na sua própria cor, igual ao dicionário. Estrutura/funcionamento do
     accordion (clique expande/colapsa, classe .colapsado) não muda. */
  .cat-header{
    display:flex;
    align-items:center;
    gap:8px;
    cursor:pointer;
    user-select:none;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--cat-accent, var(--border));
    border-radius:12px;
    padding: 8px 11px !important;
    margin: 0 0 8px !important;
    box-shadow: 0 1px 3px rgba(0,0,0,.14), inset 0 1px 0 0 rgba(255,255,255,.08), inset 0 -3px 7px 0 rgba(0,0,0,.3);
    transition: background-color .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease;
  }
  body.light .cat-header{ box-shadow: 0 1px 2px rgba(35,40,48,.04), inset 0 1px 0 0 rgba(255,255,255,.6), inset 0 -2px 5px 0 rgba(35,40,48,.05); }
  .cat-header:hover{
    background: var(--hover-tint);
    border-color: color-mix(in srgb, var(--cat-accent, var(--red-bright)) 70%, var(--border));
    box-shadow: 0 7px 18px -4px color-mix(in srgb, var(--cat-accent, var(--red-bright)) 42%, rgba(0,0,0,.3)), inset 0 1px 0 0 rgba(255,255,255,.12), inset 0 -3px 8px 0 rgba(0,0,0,.35);
    transform: translateY(-2px);
  }
  body.light .cat-header:hover{ box-shadow: 0 7px 18px -4px color-mix(in srgb, var(--cat-accent, var(--red-bright)) 30%, rgba(35,40,48,.1)), inset 0 1px 0 0 rgba(255,255,255,.7), inset 0 -2px 6px 0 rgba(35,40,48,.07); }
  .cat-header:hover{ border-left-color: var(--cat-accent, var(--red-bright)); }
  .cat-badge{
    width:26px;height:26px;border-radius:9px;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;
    background:linear-gradient(145deg, color-mix(in srgb, var(--cat-accent, var(--text-dim)) 30%, transparent), color-mix(in srgb, var(--cat-accent, var(--text-dim)) 10%, transparent));
    border:1px solid color-mix(in srgb, var(--cat-accent, var(--text-dim)) 38%, transparent);
    box-shadow:0 2px 8px color-mix(in srgb, var(--cat-accent, var(--text-dim)) 30%, transparent), inset 0 1px 0 rgba(255,255,255,.12);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .cat-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background: linear-gradient(145deg, color-mix(in srgb, var(--cat-accent, var(--text-dim)) 100%, transparent), color-mix(in srgb, var(--cat-accent, var(--text-dim)) 50%, transparent));
    box-shadow: 0 0 6px 1px var(--cat-accent-glow, transparent), inset 0 1px 1px rgba(255,255,255,.35);
    flex-shrink:0;
    transition: box-shadow .18s ease;
  }
  .cat-header:hover .cat-badge{
    transform: scale(1.08) rotate(-4deg);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--cat-accent, var(--text-dim)) 48%, transparent), inset 0 1px 0 rgba(255,255,255,.16);
  }
  .cat-header:hover .cat-dot{ box-shadow: 0 0 9px 2px var(--cat-accent-glow, transparent), inset 0 1px 1px rgba(255,255,255,.4); }
  .cat-label{ display:flex; align-items:center; gap:9px; min-width:0; flex:1; }
  .cat-count-mini{
    font-size:.62rem; font-weight:700; color:var(--text-dim);
    background: var(--panel); border:1px solid var(--border);
    padding:2px 7px; border-radius:20px; flex-shrink:0;
  }
  .cat-items{
    overflow:hidden;
    max-height: 900px;
    opacity: 1;
    transition: max-height .32s ease, opacity .25s ease;
  }
  .cat-group.colapsado .cat-items{ max-height:0; opacity:0; }
  .cat-group.colapsado .cat-header{ margin-bottom: 0 !important; }
  .cat-header:active{ transform: translateY(0) scale(.98); }

  /* ---------- Favoritos na sidebar ---------- */
  .fav-header{
    display:flex;
    align-items:center;
    gap:6px;
    font-size:.66rem;
    text-transform:uppercase;
    letter-spacing:1.1px;
    color: var(--amber);
    font-weight:800;
    background: var(--sidebar);
    border: 1px solid rgba(232,184,75,.3);
    border-radius:7px;
    padding: 7px 10px;
    margin: 0 0 8px;
  }
  .fav-header .icon{ width:12px; height:12px; }
  .fav-group{ margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px dashed var(--border); }
  .drug-item .fav-dot{ margin-left:auto; color: var(--amber); width:12px; height:12px; flex-shrink:0; }

  /* ---------- Menu inferior mobile (busca + favoritos) ---------- */
  .mobile-bottom-nav{ display:none; }
  .mobile-bottom-nav-item{
    display:flex; flex-direction:column; align-items:center; gap:3px;
    background:none; border:none; color: var(--text-dim);
    font-family: inherit; font-size:.65rem; font-weight:700;
    cursor:pointer; padding:6px 22px; border-radius:10px;
    position:relative;
    transition: background-color .15s ease, transform .12s ease;
    -webkit-tap-highlight-color:transparent;
  }
  .mobile-bottom-nav-item .icon{ width:19px; height:19px; }
  .mobile-bottom-nav-item:active{ background: var(--hover-tint); transform: scale(.93); }
  .mobile-bottom-nav-item .fav-count{
    position:absolute; top:1px; right:13px;
    min-width:14px; height:14px; padding:0 3px;
    border-radius:7px; background: var(--red-bright); color:#fff;
    font-size:.58rem; font-weight:800; line-height:14px; text-align:center;
  }
  .mobile-search-fechar{
    display:none;
    align-items:center; justify-content:center;
    width:26px; height:26px; flex-shrink:0;
    border:none; background:transparent; color: var(--text-dim);
    cursor:pointer; border-radius:50%;
    -webkit-tap-highlight-color:transparent;
  }
  .mobile-search-fechar .icon{ width:14px; height:14px; }
  .mobile-search-fechar:hover{ background: var(--hover-tint); color: var(--text); }
  .mobile-search-backdrop{
    display:none;
    position:fixed; inset:0;
    background: rgba(0,0,0,.55);
    z-index:990;
  }
  body.mobile-search-open .mobile-search-backdrop{ display:block; }

  /* ---------- Skeleton de carregamento ---------- */
  .skeleton-item{
    height: 14px;
    border-radius: 6px;
    margin: 10px 12px;
    background: linear-gradient(90deg, var(--card) 25%, var(--card-hover) 50%, var(--card) 75%);
    background-size: 200% 100%;
    animation: skeleton-pulse 1.3s ease-in-out infinite;
  }
  @keyframes skeleton-pulse{
    0%{ background-position: 200% 0; }
    100%{ background-position: -200% 0; }
  }

  /* ---------- Botões de ação (copiar/imprimir/compartilhar) ---------- */
  .btn-icon-action{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:34px;
    height:34px;
    padding:0;
    border:1px solid var(--border);
    color: var(--text-dim);
    background: var(--card);
    border-radius:50%;
    cursor:pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,.16), inset 0 1px 0 0 rgba(255,255,255,.08);
    transition: all .15s;
    flex-shrink:0;
  }
  body.light .btn-icon-action{ box-shadow: 0 1px 4px rgba(23,26,32,.08), inset 0 1px 0 0 rgba(255,255,255,.6); }
  .btn-icon-action .icon{ width:16px; height:16px; }
  .btn-icon-action:hover{ background: var(--hover-tint); color: var(--text); border-color: var(--text-dim); box-shadow: 0 6px 16px rgba(0,0,0,.24); transform: translateY(-2px); }
  body.light .btn-icon-action:hover{ box-shadow: 0 6px 16px rgba(23,26,32,.14); }
  .btn-icon-action:active{ transform: translateY(0) scale(.92); }
  .btn-icon-action.feito{ color:#3fae6d; border-color:#3fae6d; }
  .btn-copiar-dose{
    display:inline-flex;
    align-items:center;
    gap:5px;
    background:var(--card);
    border:1px solid var(--border);
    color: var(--text-dim);
    font-size:.68rem;
    font-weight:700;
    padding: 4px 9px;
    border-radius: 20px;
    cursor:pointer;
    margin-left:auto;
    box-shadow: 0 2px 6px rgba(0,0,0,.14);
    transition: all .15s;
    white-space:nowrap;
  }
  body.light .btn-copiar-dose{ box-shadow: 0 1px 3px rgba(23,26,32,.07); }
  .btn-copiar-dose .icon{ width:11px; height:11px; }
  .btn-copiar-dose:hover{ background: var(--hover-tint); color: var(--text); box-shadow: 0 5px 12px rgba(0,0,0,.2); transform: translateY(-1px); }
  body.light .btn-copiar-dose:hover{ box-shadow: 0 5px 12px rgba(23,26,32,.12); }
  .btn-copiar-dose:active{ transform: translateY(0) scale(.95); }
  .btn-copiar-dose.feito{ color:#3fae6d; border-color:#3fae6d; }

  /* ---------- Badge de verificação de dados ---------- */
  .verificado-badge{
    display:inline-flex;
    align-items:center;
    gap:5px;
    font-size:.7rem;
    color: var(--text-dim);
    background: var(--panel);
    border:1px solid var(--border);
    padding: 3px 10px;
    border-radius: 20px;
    margin-left:8px;
  }
  .verificado-badge .icon{ width:11px; height:11px; color:#3fae6d; }

  /* ---------- Transição de conteúdo ---------- */
  #conteudo{ animation: fade-in .18s ease; }
  @keyframes fade-in{ from{ opacity:0; transform: translateY(3px); } to{ opacity:1; transform:none; } }

  /* ---------- Layout mobile — navegação em vista única + polimento de toque ----------
     Este bloco vem depois de todas as regras base que ele sobrescreve (inclusive as
     redefinições de .cat-header/.btn-icon-action mais acima), para não perder o empate
     de especificidade por ordem de declaração. */
  @media (max-width: 800px){
    .main-header{ flex-wrap:wrap; row-gap:12px; }
    .main-header-actions{ flex-wrap:wrap; width:100%; }

    /* Vista única: lista de fármacos OU fármaco selecionado, nunca as duas ao mesmo
       tempo. #app-body recebe a classe correspondente em selecionarFarmaco() /
       mobileMostrarLista() / voltarParaCategoria(). Seletores com duas classes aqui
       têm especificidade maior que as regras base de .sidebar/.main (uma classe só),
       então a ordem no arquivo não importa para este par. */
    .app-body.mobile-vista-farmaco .sidebar{ display:none; }
    .app-body.mobile-vista-lista .main{ display:none; }
    .app-body.mobile-vista-farmaco .btn-mobile-voltar{ display:inline-flex; }

    /* Áreas de toque maiores, mais fáceis de operar com uma mão no balcão */
    .btn-icon-action, .btn-fav-calc{ width:40px; height:40px; }
    .aviso-titulo{ align-items:flex-start; }

    /* 07/11/2026: grade de cartões/tiles no mobile, a pedido do usuário —
       substitui a lista horizontal "esticada" (herdada das rodadas de 23/08
       e 05/11 anteriores, que só ajustavam densidade/raio da lista em linha
       única) por um grid de cards quadrados/levemente retangulares, com
       indicador colorido de categoria no topo do cartão, texto centralizado
       com quebra de linha normal (nomes longos como "Sulfametoxazol +
       Trimetoprima" quebram em 2-3 linhas, sem corte/ellipsis) e touch
       target bem acima do mínimo de 44x44px recomendado. O cabeçalho de
       categoria (.cat-header, accordion) não muda — só a lista de fármacos
       dentro de cada categoria vira grid.
       07/11/2026 (ajuste): usuário pediu 3 colunas em vez de 2 — reduzido
       gap/padding/fonte/min-height proporcionalmente para caber 3 cartões
       por linha em telas de ~390px sem ficar apertado nem gerar overflow,
       mantendo o touch target bem acima de 44x44px. */
    .cat-items{
      display:grid;
      grid-template-columns:repeat(3, 1fr);
      gap:6px;
    }
    .drug-item{
      flex-direction:column;
      justify-content:center;
      text-align:center;
      min-height:68px;
      padding:9px 5px;
      gap:5px;
      margin:0;
      border-radius:12px;
      border-left-width:0;
      font-size:.68rem;
      line-height:1.2;
    }
    .drug-item .drug-label{
      white-space:normal;
      overflow-wrap:break-word;
    }
    .drug-item .drug-dot{ width:14px; height:14px; border-radius:4px; margin-bottom:1px; }
    /* O modal de Favoritos (menu inferior mobile) reaproveita o mesmo
       .drug-item via criarBotaoFarmaco() — mesma grade de 3 colunas, para
       manter a consistência visual com a lista principal. O modal de "Nomes
       comerciais" (#comerciais-body) usa outro conteúdo e NÃO é afetado, pois
       o seletor abaixo é por ID (#favoritos-body), não pela classe
       compartilhada .comerciais-body. */
    #favoritos-body{
      display:grid;
      grid-template-columns:repeat(3, 1fr);
      gap:6px;
    }
    .cat-header{ padding: 6px 9px !important; margin-bottom:5px !important; gap:7px; }
    .cat-badge{ width:22px; height:22px; border-radius:6px; }
    .cat-badge .cat-dot{ width:14px; height:14px; border-radius:4px; }
    .cat-count-mini{ display:none; }
    .cat-group{ margin-top:12px; }
    .cat-group:first-child{ margin-top:4px; }
    .sidebar-list{ padding:8px 10px 76px; }

    /* Campo de busca e Favoritos saem da sidebar e viram um menu inferior fixo —
       a busca abre como um cartão flutuante por cima da lista (que continua
       visível e filtrando em tempo real atrás dele); Favoritos abre no mesmo
       modal centralizado já usado para "Nomes comerciais" (#comerciais-overlay). */
    .sidebar-header{ display:none; }
    .fav-group{ display:none; }
    .mobile-bottom-nav{
      display:flex;
      position:fixed; left:0; right:0; bottom:0;
      z-index:960;
      justify-content:center; gap:6px;
      background: var(--sidebar);
      border-top:1px solid var(--border);
      padding: 6px 16px calc(6px + env(safe-area-inset-bottom));
      box-shadow: 0 -6px 18px rgba(0,0,0,.28);
    }
    body.light .mobile-bottom-nav{ box-shadow: 0 -6px 18px rgba(35,40,48,.1); }
    .main{ padding-bottom:76px; }

    body.mobile-search-open .sidebar-header{
      display:block;
      position:fixed;
      top:calc(10px + env(safe-area-inset-top));
      left:12px; right:12px;
      z-index:1000;
      margin:0;
      padding:10px 12px;
      background: var(--sidebar);
      border:1px solid var(--border);
      border-bottom:1px solid var(--border);
      border-radius:12px;
      box-shadow: 0 14px 34px -10px rgba(0,0,0,.55);
    }
    body.mobile-search-open .mobile-search-fechar{ display:inline-flex; }
    /* .sidebar é item flex com z-index:2, o que já basta para formar seu próprio
       contexto de empilhamento — mesmo com .sidebar-header em position:fixed e
       z-index:1000, esse valor só é comparado DENTRO do contexto de .sidebar, que
       por sua vez perde para o backdrop (z-index:990) na comparação externa (mesma
       classe de bug já corrigida no farmadesk). No mobile as duas vistas nunca
       aparecem lado a lado (ver .mobile-vista-lista/.mobile-vista-farmaco acima),
       então o z-index de .sidebar não tem mais função aqui: zerá-lo remove o
       contexto de empilhamento e deixa .sidebar-header (fixed) competir direto no
       nível raiz, ficando acima do backdrop; o restante da lista (.sidebar-list,
       estático) permanece abaixo do backdrop e é corretamente escurecido/bloqueado. */
    .sidebar{ z-index:auto; }
    body.mobile-search-open .mobile-bottom-nav{ display:none; }
  }

  /* ---------- 10/11/2026: memória de cálculo, visual da dose, teto, etiqueta ---------- */
  .form-acoes{ margin-left:auto; display:flex; gap:6px; flex-wrap:wrap; justify-content:flex-end; }
  .form-acoes .btn-copiar-dose{ margin-left:0; }
  .memoria-calculo{ margin: 2px 0 12px; padding: 10px 12px; border-radius: 12px; background: var(--hover-tint); border: 1px dashed var(--border); }
  .memoria-titulo{ display:flex; align-items:center; gap:6px; font-size:.64rem; font-weight:800; letter-spacing:.6px; text-transform:uppercase; color: var(--text-dim); margin-bottom:6px; }
  .memoria-titulo .icon{ width:11px; height:11px; color:#3fae6d; }
  .eq-linha{ display:flex; flex-wrap:wrap; align-items:center; gap:5px; font-size:.78rem; line-height:1.4; padding:3px 0; }
  .eq-linha + .eq-linha{ border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); }
  .eq-termo{ padding: 2px 7px; border-radius: 6px; background: var(--card); border: 1px solid var(--border); font-weight:600; font-variant-numeric: tabular-nums; }
  .eq-resultado{ background: var(--pill-bg); color: var(--pill-text); border-color: color-mix(in srgb, var(--pill-text) 35%, transparent); font-weight:800; }
  .eq-op{ font-weight:800; color: var(--red-bright); font-size:.9rem; }
  .eq-nota{ font-size:.7rem; color: var(--amber); font-style: italic; }
  .visual-dose{ margin: 0 0 12px; padding: 10px 12px 8px; border-radius: 12px; background: color-mix(in srgb, var(--card) 70%, var(--bg)); border: 1px solid var(--border); text-align:center; }
  .seringa-svg{ width:100%; max-width: 340px; height:auto; display:block; margin: 0 auto; }
  .copo-svg{ width: 150px; height:auto; display:block; margin: 0 auto; }
  .comp-svg{ height: 46px; width:auto; max-width:100%; display:block; margin: 4px auto; }
  .sr-tubo{ fill: none; stroke: var(--text-dim); stroke-width: 1.6; }
  .sr-corpo{ fill: var(--border); }
  .sr-haste{ stroke: var(--border); stroke-width: 6; stroke-linecap: round; }
  .sr-aba{ stroke: var(--text-dim); stroke-width: 2.4; stroke-linecap: round; }
  .sr-embolo-borracha{ fill: var(--text-gray); }
  .sr-liquido{ fill: #4ab496; opacity: .85; }
  .tipo-injetavel .sr-liquido{ fill: #ef6b7b; }
  .sr-faixa{ fill: #4ab496; opacity: .35; }
  .tipo-injetavel .sr-faixa{ fill: #ef6b7b; }
  .sr-tick{ stroke: var(--text-gray); stroke-width: 1; }
  .sr-num{ fill: var(--text-dim); font-size: 8.5px; text-anchor: middle; font-family: inherit; font-weight: 600; }
  .sr-marca{ stroke: var(--red-bright); stroke-width: 1.6; stroke-dasharray: 4 3; }
  .cp-fundo{ fill: none; stroke: var(--border); stroke-width: 1.5; stroke-dasharray: 3 3; }
  .cp-cheio{ fill: #b482dc; }
  .cp-cheio2{ fill: #d2b4ee; }
  .cp-sulco{ stroke: rgba(255,255,255,.55); stroke-width: 1.5; }
  .cp-corte{ stroke: var(--red-bright); stroke-width: 1.5; stroke-dasharray: 3 2; }
  .cp-opcional .cp-cheio{ opacity: .45; }
  .visual-legenda{ font-size: .72rem; color: var(--text-dim); margin-top: 4px; line-height:1.4; }
  .visual-legenda b{ color: var(--text); }
  .teto-box{ margin: 0 0 14px; padding: 12px 14px; border-radius: 14px; background: var(--card); border: 1px solid var(--border); --teto: #3fae6d; }
  .teto-perto{ --teto: var(--amber); }
  .teto-no-teto{ --teto: var(--red-bright); }
  .teto-topo{ display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:8px; }
  .teto-titulo{ font-size:.68rem; font-weight:800; letter-spacing:.6px; text-transform:uppercase; color: var(--text-dim); }
  .teto-status{ font-size:.72rem; font-weight:700; color: var(--teto); }
  .teto-barra{ position:relative; height: 10px; border-radius: 6px; background: var(--hover-tint); border: 1px solid var(--border); overflow:hidden; }
  .teto-cheio, .teto-faixa{ position:absolute; top:0; bottom:0; left:0; background: var(--teto); }
  .teto-faixa{ opacity: .4; }
  .teto-legenda{ display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-top:7px; font-size:.74rem; color: var(--text-dim); }
  .teto-legenda b{ color: var(--text); }
  /* Etiqueta */
  .etiqueta-modal{ max-width: 860px !important; max-height: 92vh !important; }
  .etiqueta-corpo{ display:grid; grid-template-columns: minmax(0,1fr) calc(90mm + 4px); gap: 18px; padding: 16px 20px 20px; }
  .etq-form{ display:flex; flex-direction:column; gap:10px; }
  .etq-form label{ display:flex; flex-direction:column; gap:4px; font-size:.7rem; font-weight:700; color: var(--text-dim); text-transform:uppercase; letter-spacing:.4px; }
  .etq-form input, .etq-form textarea{ font: inherit; font-size:.85rem; text-transform:none; letter-spacing:0; font-weight:500; color: var(--text); background: var(--panel); border:1px solid var(--border); border-radius: 9px; padding: 8px 10px; }
  .etq-form textarea{ resize: vertical; min-height: 54px; }
  .etq-form .etq-par{ display:grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .etq-aviso{ font-size:.74rem; color: var(--amber); background: color-mix(in srgb, var(--amber) 12%, transparent); border:1px solid color-mix(in srgb, var(--amber) 40%, transparent); border-radius: 8px; padding: 7px 9px; }
  .etq-lado{ display:flex; flex-direction:column; gap:12px; }
  .etq-lado-titulo{ font-size:.7rem; font-weight:800; color: var(--text-dim); text-transform:uppercase; letter-spacing:.5px; }
  .etiqueta-papel, #etiqueta-preview{ width: 90mm; max-width:100%; min-height: 50mm; box-sizing:border-box; background:#fff; color:#111; border: 1.5px dashed #999; border-radius: 6px; padding: 3.5mm 4mm; font-family: 'Inter', Arial, sans-serif; font-size: 9.5pt; line-height: 1.3; }
  #etiqueta-preview{ box-shadow: 0 6px 20px rgba(0,0,0,.25); }
  .etq-cab{ display:flex; justify-content:space-between; font-size: 7.5pt; color:#555; border-bottom: 1px solid #ddd; padding-bottom: 1.5mm; margin-bottom: 1.5mm; }
  .etq-marca b{ color:#d4152a; }
  .etq-paciente{ font-weight: 700; font-size: 9.5pt; margin-bottom: 1mm; }
  .etq-vazio{ font-weight: 400; color:#666; }
  .etq-med{ font-weight: 800; font-size: 12pt; line-height:1.15; }
  .etq-apres{ font-size: 8pt; color:#444; margin-bottom: 1.5mm; }
  .etq-dose{ font-size: 10.5pt; background: #fff4d6; border-radius: 3px; padding: 1mm 1.5mm; margin-bottom: 1.5mm; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .etq-linha{ display:flex; gap: 2mm; font-size: 9pt; }
  .etq-linha span{ color:#555; min-width: 15mm; }
  .etq-obs{ font-size: 8.5pt; margin-top: 1mm; font-style: italic; }
  .etq-prof{ font-size: 7.5pt; color:#555; border-top: 1px solid #ddd; margin-top: 1.5mm; padding-top: 1mm; }
  .etq-acoes{ display:flex; gap:8px; justify-content:flex-end; }
  .etq-form select{ font: inherit; font-size:.85rem; text-transform:none; letter-spacing:0; font-weight:500; color: var(--text); background: var(--panel); border:1px solid var(--border); border-radius: 9px; padding: 8px 10px; }
  .etq-drog{ font-weight:800; color:#111; font-size: 8.5pt; text-transform: uppercase; letter-spacing:.3px; }
  .etq-dica-cupom{ font-size:.72rem; line-height:1.4; color: var(--text-dim); background: var(--hover-tint); border-radius:8px; padding:7px 9px; max-width: 90mm; }
  /* Cupom térmico: só preto, sem fundo (impressoras térmicas não imprimem cor), largura útil da bobina */
  #etiqueta-preview.fmt-cupom80, .etiqueta-papel.fmt-cupom80{ width: 72mm; min-height: 0; border: 1px dashed #bbb; border-radius: 0; padding: 3mm 2mm 5mm; font-size: 10.5pt; }
  #etiqueta-preview.fmt-cupom58, .etiqueta-papel.fmt-cupom58{ width: 48mm; min-height: 0; border: 1px dashed #bbb; border-radius: 0; padding: 2.5mm 1mm 4mm; font-size: 9pt; }
  .fmt-cupom80 .etq-cab, .fmt-cupom58 .etq-cab{ flex-direction: column; align-items: center; text-align: center; gap: 1mm; border-bottom: 1px dashed #000; color:#000; }
  .fmt-cupom80 .etq-drog, .fmt-cupom58 .etq-drog{ font-size: 1.05em; }
  .fmt-cupom80 .etq-dose, .fmt-cupom58 .etq-dose{ background: none; border: 1.5px solid #000; border-radius: 0; font-size: 1.1em; }
  .fmt-cupom80 .etq-med, .fmt-cupom58 .etq-med{ font-size: 1.25em; }
  .fmt-cupom58 .etq-linha{ flex-direction: column; gap: 0; }
  .fmt-cupom80 *, .fmt-cupom58 *{ color:#000 !important; }
  .fmt-cupom80 .etq-prof, .fmt-cupom58 .etq-prof{ border-top: 1px dashed #000; text-align:center; }
  .etq-btn{ font: inherit; font-weight:700; font-size:.82rem; border-radius: 10px; padding: 9px 14px; cursor:pointer; border:1px solid var(--border); background: var(--panel); color: var(--text); }
  .etq-btn.primario{ background: var(--red); border-color: var(--red); color:#fff; }
  #etiqueta-print-area{ display:none; }
  @media (max-width: 680px){
    .etiqueta-corpo{ grid-template-columns: 1fr; }
    .etq-lado{ order: -1; align-items:center; }
    .eq-linha{ font-size: .74rem; }
  }
  @media print{
    .memoria-calculo, .visual-dose, .teto-box{ break-inside: avoid; background:#fff !important; border-color:#bbb !important; color:#000 !important; }
    .eq-termo{ background:#f4f4f4 !important; border-color:#ccc !important; color:#000 !important; }
    .eq-resultado{ background:#f2b84b !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .teto-cheio, .teto-faixa, .sr-liquido, .sr-faixa, .cp-cheio{ -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    html{ background:#fff !important; }
    .mobile-bottom-nav{ display:none !important; }
    .etiqueta-overlay-x{ display:none !important; }
    body.imprimindo-etiqueta > *:not(#etiqueta-print-area){ display:none !important; }
    body.imprimindo-etiqueta #etiqueta-print-area{ display:block !important; }
    body.imprimindo-etiqueta .etiqueta-papel{ border: 1px dashed #999; }
    body.imprimindo-etiqueta .etiqueta-papel.fmt-cupom80, body.imprimindo-etiqueta .etiqueta-papel.fmt-cupom58{ border: none; margin: 0 auto; }
    @page{ margin: 8mm; }
  }
  /* ---------- Impressão ---------- */
  .print-only{ display:none; }
  @media print{
    body.light, body{ background: #fff !important; color:#000 !important; }
    .gate-overlay, .topbar-app, .sidebar, .theme-toggle, .btn-fav-calc, .btn-bula,
    .btn-icon-action, .btn-copiar-dose, .peso-bar .unidade-toggle, .aviso-responsabilidade,
    .breadcrumb-chip, .btn-nomes-comerciais, .comerciais-overlay, .no-print{ display:none !important; }
    .print-only{ display:block !important; }
    .app-body{ display:block !important; }
    .main{ padding:0 !important; overflow:visible !important; height:auto !important; }
    .main-inner{ max-width:100% !important; }
    .resultado-grid{ max-width:100% !important; display:block !important; }
    #observacoes-container{ position:static !important; }
    .formulacao, .observacoes{ box-shadow:none !important; border:1px solid #999 !important; break-inside: avoid; }
    .valor-pill{ background:#f2b84b !important; color:#000 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .print-only{ font-size:.72rem; color:#444; line-height:1.5; margin-top:18px; padding-top:12px; border-top:1px solid #ccc; }
    .formula-content{ display:block !important; color:#333 !important; }
    .formula-steps li{ background:#f7f7f7 !important; border-color:#ccc !important; color:#333 !important; break-inside: avoid; }
    .formula-steps li::before{ background:#eee !important; color:#a10f1f !important; }
    a[href]:after{ content:""; }
  }
</style>
</head>
<body class="gate-aberto">
<script>try{ if(localStorage.getItem('farmapratica-theme')==='light'){ document.body.classList.add('light'); } }catch(e){}</script>

<div class="gate-overlay" id="gate-overlay">
  <div class="gate-modal">
    <div class="gate-header">
      <h2>Antes de continuar</h2>
      <p>Leia o aviso legal abaixo</p>
    </div>
    <div class="gate-body">
      <p><strong>Aviso Legal e Limitação de Responsabilidade.</strong> Esta calculadora é uma ferramenta de apoio à consulta técnica, destinada exclusivamente a profissionais farmacêuticos e da saúde devidamente habilitados. Não constitui prescrição, diagnóstico ou substituto da avaliação clínica individualizada do paciente.</p>
      <p>As informações têm caráter informativo e podem conter desatualizações ou imprecisões em relação a bulas e diretrizes vigentes. É responsabilidade do usuário confirmar posologia, dose máxima, contraindicações e interações na bula oficial vigente antes de qualquer orientação ao paciente.</p>
      <p>O uso é de inteira responsabilidade do usuário. O autor não se responsabiliza por decisões clínicas tomadas com base neste conteúdo, nem por uso fora do contexto profissional para o qual foi concebido.</p>
      <label class="gate-check">
        <input type="checkbox" id="gate-checkbox">
        Declaro que sou profissional de saúde habilitado, li o aviso acima e assumo a responsabilidade pelo uso deste material.
      </label>
      <button class="gate-btn" id="gate-btn" disabled>Continuar</button>
    </div>
  </div>
</div>

<div class="comerciais-overlay etiqueta-overlay-x" id="etiqueta-overlay" role="dialog" aria-modal="true" aria-labelledby="etiqueta-titulo">
  <div class="comerciais-modal etiqueta-modal">
    <div class="comerciais-header">
      <h3 id="etiqueta-titulo">Etiqueta de posologia</h3>
      <button type="button" class="comerciais-fechar" id="etiqueta-fechar" aria-label="Fechar">
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
      </button>
    </div>
    <div class="etiqueta-corpo">
      <div class="etq-form">
        <div class="etq-par">
          <label>Drogaria / farmácia<input id="etq-drogaria" type="text" placeholder="Nome do estabelecimento" autocomplete="off"></label>
          <label>Formato de impressão<select id="etq-formato">
            <option value="etiqueta">Etiqueta 90 × 50 mm</option>
            <option value="cupom80">Cupom térmico 80 mm</option>
            <option value="cupom58">Cupom térmico 58 mm</option>
          </select></label>
        </div>
        <label>Paciente<input id="etq-paciente" type="text" placeholder="Nome (opcional)" autocomplete="off"></label>
        <label>Dose a administrar<input id="etq-dose" type="text"></label>
        <div class="etq-aviso" id="etq-aviso-faixa" hidden>A dose está em faixa. Defina um valor único antes de imprimir.</div>
        <label>Via e frequência<input id="etq-via" type="text"></label>
        <div class="etq-par">
          <label>1ª dose às<input id="etq-inicio" type="time"></label>
          <label>Duração (dias)<input id="etq-dias" type="number" min="1" step="1" placeholder="—"></label>
        </div>
        <label>Observação<textarea id="etq-obs" placeholder="Ex.: agitar antes de usar; manter na geladeira após aberto"></textarea></label>
        <div class="etq-par">
          <label>Farmacêutico(a)<input id="etq-prof" type="text" autocomplete="off"></label>
          <label>CRF<input id="etq-crf" type="text" placeholder="CRF-UF 0000" autocomplete="off"></label>
        </div>
      </div>
      <div class="etq-lado">
        <span class="etq-lado-titulo" id="etq-prev-titulo">Prévia (90 × 50 mm)</span>
        <div class="etq-dica-cupom" id="etq-dica-cupom" hidden>Na janela de impressão, escolha a impressora térmica, margens <b>Nenhuma</b> e desmarque <b>Cabeçalhos e rodapés</b>.</div>
        <div id="etiqueta-preview"></div>
        <div class="etq-acoes">
          <button type="button" class="etq-btn" onclick="fecharEtiqueta()">Cancelar</button>
          <button type="button" class="etq-btn primario" id="etq-imprimir">Imprimir etiqueta</button>
        </div>
      </div>
    </div>
  </div>
</div>
<div id="etiqueta-print-area"></div>

<div class="comerciais-overlay" id="comerciais-overlay" role="dialog" aria-modal="true" aria-labelledby="comerciais-titulo">
  <div class="comerciais-modal">
    <div class="comerciais-header">
      <h3 id="comerciais-titulo">Nomes comerciais</h3>
      <button type="button" class="comerciais-fechar" id="comerciais-fechar" aria-label="Fechar">
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
      </button>
    </div>
    <div class="comerciais-body" id="comerciais-body"></div>
  </div>
</div>

<div class="comerciais-overlay" id="favoritos-overlay" role="dialog" aria-modal="true" aria-labelledby="favoritos-titulo">
  <div class="comerciais-modal">
    <div class="comerciais-header">
      <h3 id="favoritos-titulo">Favoritos</h3>
      <button type="button" class="comerciais-fechar" id="favoritos-fechar" aria-label="Fechar">
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg></span>
      </button>
    </div>
    <div class="comerciais-body" id="favoritos-body"></div>
  </div>
</div>

